.detail-card{width:480rpx;height:672rpx;margin-left:auto;margin-right:auto}.fact-row{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1px solid #1b2a3314;font-size:24rpx;gap:20rpx}.fact-row:last-of-type{margin-bottom:20rpx}.note{width:100%;height:190rpx;background:#f2f0ea;border-radius:24rpx;padding:20rpx;margin:24rpx 0;font-size:25rpx}.modal{position:fixed;top:0;right:0;bottom:0;left:0;z-index:50;display:flex;align-items:center;justify-content:center;background:#172026}.mask{position:absolute;inset:0;background:#172026}.close{position:absolute;right:35rpx;top:30rpx;background:#fffdf6;width:84rpx;height:84rpx;border-radius:50%;font-size:48rpx;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;z-index:3}.showcase{width:580rpx;position:relative;z-index:2}.scene{width:560rpx;height:784rpx;margin:auto;will-change:transform;contain:layout style}.scene.dragging{transition:none}.scene.resting{transition:transform .2s cubic-bezier(.22,1,.36,1)}.flipper{width:100%;height:100%;position:relative;will-change:transform;contain:layout style}.flipper.out{transition:transform .18s cubic-bezier(.55,0,1,.45)}.flipper.edge{transition:none;opacity:0}.flipper.in{transition:transform .22s cubic-bezier(.22,1,.36,1)}.flipper.reduced,.flipper.idle{transition:none}.white-hint{text-align:center;color:#f7f3e9;font-size:22rpx;line-height:1.7;margin:28rpx 0}.showcase .secondary{font-size:23rpx;padding:15rpx;min-height:78rpx}.science{font-size:26rpx;line-height:1.65;padding:22rpx 0;border-bottom:1rpx solid #d9d7c9;white-space:normal;word-break:break-all}.science .sub{margin-bottom:8rpx}.fact-row>text:first-child{flex:0 0 125rpx}.fact-row>text:last-child{flex:1;min-width:0;word-break:break-all;text-align:right}
/* C theme alignment, preserving card and capture mechanics. */
.note{background:var(--paper);color:var(--ink);font-size:28rpx;line-height:1.55;border:1rpx solid var(--line)}.science,.fact-row{border-color:var(--line);font-size:28rpx}.modal,.mask{background:#18352E}.close{background:#FFFCF4;color:#183F36;min-width:88rpx;min-height:88rpx}.white-hint{color:#FFF8E8;font-size:24rpx}.showcase .secondary{min-height:88rpx;font-size:26rpx}.fact-row>text:first-child{flex-basis:150rpx}
