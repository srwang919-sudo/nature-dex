<view wx:if="{{!hidden}}" class="dock" style="{{safeBottom?'padding-bottom: '+(safeBottom+4)+'px;':''}}">
  <view class="tabs">
    <view wx:for="{{navigationItems}}" wx:key="key" class="tab {{currentKey===item.key?'on':''}}" data-key="{{item.key}}" bindtap="go" aria-role="button" aria-label="{{currentKey===item.key?item.label+'，当前页面':item.label}}">
      <view class="icon-wrap"><view class="icon {{item.icon}}"></view></view>
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>
  <view class="dock-fab" bindtap="record" aria-role="button" aria-label="记录一次相遇">
    <view class="fab-camera"></view>
  </view>
</view>
