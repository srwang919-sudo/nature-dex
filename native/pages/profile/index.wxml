<view class="page profile-page {{reduce?'reduce-motion':''}}" wx:if="{{profile}}">
  <view class="identity"><button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{avatarSaving}}" aria-label="主动选择本地头像"><image wx:if="{{avatarPath}}" class="avatar-image" src="{{avatarPath}}" mode="aspectFill"/><text wx:else>选头像</text></button><view class="identity-copy"><view class="identity-name">{{profile.name}}</view><text class="identity-meta">{{profile.stats.species}} 种记录 · 观察 {{profile.stats.days}} 天</text></view></view>
  <view class="summary-grid"><view><text class="summary-number">{{profile.stats.count}}</text><text>已收录</text></view><view><text class="summary-number">{{profile.stats.days}}</text><text>观察天数</text></view><view><text class="summary-number">{{profile.stats.badges}}</text><text>徽章</text></view></view>
  <view class="level-card"><view class="row between"><text class="section">探索经验 · 等级 {{profile.level}}</text><text class="level-number">{{profile.xp}}{{profile.nextXp?' / '+profile.nextXp:' 种'}}</text></view><view class="level-track"><view class="level-fill" style="width:{{profile.levelPercent}}%"></view></view><text class="sub">每收藏一种真实物种增加 1 经验，重复和案例不计入。{{profile.nextXp?'下一级需要 '+profile.nextXp+' 种。':'已达当前最高等级。'}}与工艺、保护等级和识别准确率无关。</text></view>
  <view class="badge-heading"><text class="section">我的自然勋章</text><text class="sub">十二个探索印记 · 仅来自真实观察与主动阅读</text></view>
  <view class="species-badge-grid"><view wx:for="{{badges}}" wx:key="key" data-id="{{item.id}}" bindtap="openBadge" aria-role="button" class="species-badge {{item.earned?'earned':''}}" aria-label="{{item.name+'，'+item.desc+(item.earned?'，已获得':'，未获得')}}"><image wx:if="{{!badgeErrors[item.key]}}" class="species-badge-image" src="{{item.asset}}" mode="aspectFit" data-key="{{item.key}}" binderror="badgeError"/><view wx:else class="badge-placeholder">勋章图片暂不可用</view><text class="species-badge-name">{{item.name}}</text><text class="species-badge-state">{{item.progress}} / {{item.target}} · {{item.earned?'已获得':'探索中'}}</text><text class="badge-condition">{{item.desc}}</text></view></view>
  <view class="subscription-card"><view class="section">本地收藏</view><view class="sub">统计仅包含你保存的观察，示例不计入。云同步、订阅与积分未开放。</view></view>
  <view wx:if="{{!notes.length}}" class="empty-notes"><view class="section">给一次遇见写下几句话</view><text class="sub">先选一张自己的收藏卡，再记录观察。</text><button class="secondary" bindtap="chooseNote">选择收藏卡</button></view><view class="notes-heading"><text class="section">我的笔记</text></view><view wx:for="{{notes}}" wx:key="id" class="note-card" data-id="{{item.id}}" bindtap="openNote"><image class="note-thumb" src="{{item.image}}" mode="aspectFill"/><view class="note-copy"><text class="note-name">{{item.zh}}</text><text class="note-text">{{item.text}}</text></view></view>
  <view class="availability-links"><button class="secondary" data-section="membership" bindtap="openSettings">会员说明 · 暂未开放</button><button class="secondary" data-section="friends" bindtap="openSettings">好友 · 暂未开放</button></view>
  <view class="settings-links"><button class="secondary" data-section="privacy" bindtap="openSettings">隐私</button><button class="secondary" data-section="help" bindtap="openSettings">帮助与反馈</button><button class="secondary" data-section="about" bindtap="openSettings">关于</button></view>
  <view class="settings-card"><text class="section">设置</text><text class="sub settings-intro">低动效模式 · 本地备份 · 由你决定是否显示已有地点信息</text><view class="setting-row"><view><text class="setting-name">显示拍摄地点</text><text class="sub">仅使用卡片中已保存的地点信息，不显示精确坐标或分钟级时间。</text></view><button class="setting-choice" bindtap="toggleLocation">{{showLocation?'显示':'隐藏'}}</button></view><view class="setting-row"><view><text class="setting-name">揭晓动画</text><text class="sub">可随时切换为低动效的直接揭晓。</text></view><button class="setting-choice" bindtap="toggleMotion">{{reduce?'低动效':'标准'}}</button></view><button class="settings-link" bindtap="settings">更多设置与本地备份 →</button></view>
  <view class="brand-footer"><text>本地观察者</text><text>去大自然里 · v0.1 原型</text></view>
</view>
<navigation active="me"/>
<view wx:if="{{badgePreviewOpen && selectedBadge}}" class="badge-preview-mask" bindtap="closeBadge" catchtouchmove="previewContent" aria-role="dialog" aria-label="{{selectedBadge.name}}">
 <scroll-view class="badge-preview-panel" scroll-y="{{true}}" catchtap="previewContent" catchtouchmove="previewContent">
  <button class="badge-preview-close" bindtap="closeBadge" aria-label="关闭勋章预览">关闭 ×</button>
  <image wx:if="{{!previewImageFailed}}" class="badge-preview-image {{selectedBadge.earned?'':'badge-preview-locked'}}" src="{{selectedBadge.asset}}" mode="aspectFit" binderror="previewBadgeError"/>
  <view wx:else class="badge-preview-fallback">勋章图片暂时无法读取，关闭后再打开可重试。</view>
  <view class="title">{{selectedBadge.name}}</view>
  <text class="badge-preview-state">{{selectedBadge.earned?'已获得':'尚未获得'}}</text>
  <text class="badge-preview-rule">{{selectedBadge.desc}}</text>
  <text class="badge-preview-progress">当前进度 {{selectedBadge.progress}} / {{selectedBadge.target}}</text>
  <text class="sub">欣赏勋章不会改变探索进度</text>
 </scroll-view>
</view>
