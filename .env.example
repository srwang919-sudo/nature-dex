# Server-side console template only. Never put real values into this tracked file.
# Required for image recognition (recognizeObservation).
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# Operator allowlist. Optional self-claim is disabled when its code is absent;
# use a unique high-entropy code and remove it once operators are provisioned.
NATURE_ADMIN_OPENIDS=
NATURE_OPERATOR_CLAIM_CODE=
# Required for the artwork reconciliation scheduled job.
NATURE_ARTWORK_JOB_TOKEN=
# Required only when enabling paid membership (natureMembership).
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_MERCHANT_SERIAL_NO=
WXPAY_MERCHANT_PRIVATE_KEY_PEM=
WXPAY_API_V3_KEY=
WXPAY_PUBLIC_KEY_ID=
WXPAY_PUBLIC_KEY_PEM=
WXPAY_NOTIFY_URL=
WXPAY_REFUND_NOTIFY_URL=
MEMBERSHIP_JOB_TOKEN=
# Optional tuning: OMIT unset values in the cloud console. An empty numeric
# string may mean zero (not the default), especially for daily quotas/costs.
# NATURE_ART_DAILY_LIMIT=3
# NATURE_WATERCOLOR_DAILY_LIMIT=3
# NATURE_RECOGNITION_DAILY_LIMIT=20
# NATURE_UPLOAD_DAILY_LIMIT=20
# NATURE_BAIDU_PLANT_COST=0.0029
# NATURE_BAIDU_ANIMAL_COST=0.001
# NATURE_HUNYUAN_COST=0.20
# NATURE_HUNYUAN_QUOTA_ALERT=100
# NATURE_ANALYTICS_TZ=8
# WXPAY_REQUEST_TIMEOUT_MS=5000
# WXPAY_API_BASE=https://api.mch.weixin.qq.com
# Retired: DASHSCOPE_API_KEY / DASHSCOPE_MODEL / DASHSCOPE_TEXT_MODEL.
# natureAI2 and generateIllustration now reject calls without contacting providers.
# CloudBase environment and Hunyuan access are platform/project configuration,
# not secrets consumed from a local .env file.
