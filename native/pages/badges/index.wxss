.badges-page{padding-top:32rpx}
.badges-hero{padding-bottom:28rpx;border-bottom:1rpx solid var(--line);margin-bottom:24rpx}
.badges-hero .eyebrow{display:block;color:var(--moss);font-size:22rpx;letter-spacing:.08em;margin-bottom:10rpx}
.badges-hero .title{font-size:44rpx;color:var(--ink)}
.badges-hero .sub{display:block;margin-top:10rpx;color:var(--muted);font-size:24rpx;line-height:1.65;max-width:42ch}

.filter-bar{display:flex;gap:8rpx;margin:24rpx 0}
.filter-tab{flex:1;min-height:76rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:var(--muted);border-radius:var(--radius-action);background:var(--surface);border:1rpx solid var(--border)}
.filter-tab.on{background:var(--primary-light);color:var(--moss);font-weight:600;border-color:var(--primary-light-border)}

.badge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28rpx 16rpx;margin-top:8rpx}
.badge-cell{min-width:0;min-height:88rpx;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8rpx;transition:opacity .24s ease}
.badge-cell.hidden{opacity:.22;pointer-events:none}
.badge-cell:active{transform:scale(.985)}
.badge-image{width:132rpx;height:132rpx;max-width:100%}
.badge-name{font-family:var(--font-heading);font-size:26rpx;line-height:1.5;overflow-wrap:anywhere}
.badge-tier{display:block;font-family:inherit;font-size:22rpx;color:var(--muted)}
.badge-progress{font-size:24rpx;color:var(--muted);line-height:1.5}

.empty{text-align:center;padding:56rpx 28rpx;color:var(--muted);background:var(--surface);border:1rpx dashed var(--border);border-radius:var(--radius-card);font-size:26rpx;line-height:1.7;margin-top:24rpx}

.badge-preview-mask{position:fixed;inset:0;z-index:100;background:rgba(20,43,34,.68);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}
.badge-preview-panel{width:100%;height:calc(100vh - 140rpx);max-width:660rpx;overflow:auto;padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:var(--radius-card);background:var(--surface);text-align:center}
.badge-preview-close{margin-left:auto;min-width:110rpx;min-height:88rpx;font-size:26rpx;background:transparent}
.badge-preview-image{display:block;width:380rpx;height:380rpx;max-width:100%;margin:16rpx auto}
.badge-preview-panel text{display:block}
.badge-preview-rule{font-size:28rpx;line-height:1.6;margin:16rpx 0;overflow-wrap:anywhere}
.badge-preview-progress,.badge-preview-state{font-size:26rpx;color:var(--moss);margin:14rpx 0}

.reduce-motion .badge-cell,.reduce-motion .badge-cell:active{transform:none;opacity:1}
.reduce-motion .badge-cell.hidden{opacity:.22}
@media(max-width:340px){.badge-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
