/* ============================================================
   《去大自然里》设计系统 — Master Plan §100–109
   纸白为底、墨绿为骨：现代 UI 负责操作效率，手绘世界负责情绪与品牌。
   色彩令牌与 §103 对齐；品牌绿只用于主按钮/当前状态/进度/少量关键图标。
   ============================================================ */
page{
  --paper:#F5F2E9;          /* 主背景 · 自然纸张白 */
  --surface:#FCFAF3;        /* 卡片面 · 比纸更亮半度 */
  --ink:#243028;            /* 正文 · 墨绿黑 */
  --muted:#5C675C;          /* 次级文字 · 苔灰 */
  --moss:#49634E;           /* 品牌主绿（§103：主按钮/当前状态/Progress/关键 Icon） */
  --lake:#64869A;           /* 鸟类 · 水色 */
  --sun:#C99B48;            /* 奖励色（First Discovery / 特殊收藏 / 高级徽章） */
  --orange:#B88752;         /* 昆虫 · 暖琥珀（点缀用，不作主按钮） */
  --line:#DDD8C6;           /* 1px 边线（§106：优先边线与留白，而非阴影） */
  /* 类别色（§103） */
  --c-plant:#6F8A63;
  --c-bird:#64869A;
  --c-insect:#B88752;
  --c-fungi:#A86B67;
  --c-aqua:#638E91;
  /* 形状与节奏（§105） */
  --radius-card:24rpx;
  --radius-action:20rpx;
  --space-section:48rpx;
  background:var(--paper);
  color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;
  font-size:30rpx;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
view,text,button{box-sizing:border-box}
button{font:inherit;margin:0;line-height:1.5;color:inherit;background:transparent}
button::after{border:none}

/* ---- 版式 ---- */
.page{padding:32rpx 32rpx calc(184rpx + env(safe-area-inset-bottom))}
.row{display:flex;align-items:center;gap:16rpx}
.between{justify-content:space-between}
.grow{flex:1;min-width:0}
.title{font-size:46rpx;font-weight:600;line-height:1.28;letter-spacing:.5rpx}
.section{font-size:34rpx;font-weight:600;line-height:1.4}
.brand{font-size:30rpx;font-weight:600;letter-spacing:1rpx}
.sub,.hint{font-size:25rpx;color:var(--muted);line-height:1.65}
.muted{color:var(--muted)}
.small{font-size:23rpx}
.green{color:var(--moss)}
.latin{font-family:Georgia,'Times New Roman',serif;font-style:italic}
.font-number,.number,.stats{font-family:'DIN Alternate','PingFang SC',-apple-system,sans-serif;font-variant-numeric:tabular-nums}

/* ---- 面板与容器 ---- */
.panel{background:var(--surface);border:1rpx solid var(--line);border-radius:var(--radius-card);padding:26rpx}
.spaced{margin-top:32rpx}
.pill{padding:10rpx 20rpx;border-radius:999rpx;background:var(--surface);border:1rpx solid var(--line);font-size:23rpx;color:var(--ink);white-space:nowrap}
.pill.on{background:#E6EBDD;border-color:#C9D4BC;color:#31473A}
.empty{text-align:center;padding:56rpx 28rpx;color:var(--muted);background:var(--surface);border:1rpx dashed var(--line);border-radius:var(--radius-card);font-size:26rpx;line-height:1.7}

/* ---- 操作（§102：现代 UI 负责效率；触控区 ≥88rpx）---- */
.primary,.secondary{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:20rpx 28rpx;border-radius:var(--radius-action);text-align:center;font-size:29rpx;transition:transform .18s cubic-bezier(.22,1,.36,1),opacity .18s ease}
.primary{background:var(--moss);color:#F7F5EC;font-weight:600}
.secondary{background:var(--surface);color:var(--ink);border:1rpx solid var(--line)}
.primary[disabled],.secondary[disabled]{opacity:1;background:#EAE6D9;color:#8B937F;border-color:var(--line)}
.primary:active,.secondary:active{transform:scale(.98)}
.secondary.danger{color:#A8442F;border-color:#E3CFC4}
.link{color:var(--moss);font-size:25rpx;background:none;padding:14rpx 8rpx;min-height:88rpx}

/* ---- 数据与反馈 ---- */
.track{height:18rpx;background:#E9E5D6;border-radius:999rpx;overflow:hidden;margin:20rpx 0 12rpx}
.fill{height:100%;background:var(--moss);border-radius:999rpx;transition:width .5s ease}
.notice{padding:22rpx 26rpx;border-radius:20rpx;background:#F3EBD3;border:1rpx solid #E4D6AE;font-size:25rpx;line-height:1.65;color:#5A4A28}

/* ---- 动效（§108：生长/呼吸，不用 bounce/pop；尊重系统减弱动态）---- */
.reduce-motion .primary,.reduce-motion .secondary,.reduce-motion .fill{transition:none}
@media(prefers-reduced-motion:reduce){.primary,.secondary,.fill{transition:none}.primary:active,.secondary:active{transform:none}}

/* 博物馆图鉴补充层（学名衬线、卡面专属规则） */
@import "native/styles/museum.wxss";
