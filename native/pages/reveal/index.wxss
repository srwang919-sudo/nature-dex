.reveal-page{padding-top:24rpx}.new-badge{background:#e9b93c;color:#5a4626;border-radius:40rpx;padding:12rpx 20rpx;font-size:23rpx;font-weight:700}.stage{width:480rpx;height:672rpx;margin:55rpx auto 26rpx;position:relative;perspective:1400rpx}.hero-card{width:100%;height:100%;position:relative;z-index:1}.arrive{animation:arrive .9s cubic-bezier(.2,.7,.2,1)}.seal{position:absolute;top:0;left:0;right:0;bottom:0;z-index:4;padding:22rpx;background:linear-gradient(140deg,#213d37,#152a27 55%,#314b40);color:#eee4be;box-shadow:0 15px 35px #18222a30;transform-origin:left center}.seal-line{height:100%;border:1px dashed #e2c07865;padding:35rpx 20rpx;display:flex;flex-direction:column;align-items:center;text-align:center}.seal-brand{font-size:36rpx;letter-spacing:8rpx}.seal-small{font-size:18rpx;letter-spacing:2rpx;margin-top:16rpx;color:#d5d8c8}.seal-mark{font-size:130rpx;margin:50rpx 0 22rpx;color:#dfc381}.seal-title{font-size:26rpx}.seal-bottom{margin-top:auto;font-size:16rpx;letter-spacing:2rpx}.hold-track{width:170rpx;height:5rpx;margin-top:30rpx;background:#ffffff20;border-radius:5rpx;overflow:hidden}.hold-track view{height:100%;width:0;background:#e9c97e}.holding .hold-track view{width:100%;transition:width .7s linear}.stage-split{animation:unseal .28s ease-in forwards}.stage-lift{opacity:0;transform:translateX(-80rpx) rotateY(-80deg)}.direct{margin:14rpx auto}.observation{margin-top:25rpx;font-size:24rpx}.light{position:absolute;top:-12%;left:-25%;width:150%;height:125%;background:radial-gradient(ellipse,#b0d7e755,transparent 65%);animation:glow 2s ease-out}.numbered .light{background:radial-gradient(ellipse,#f5cc6666,transparent 66%)}.alt .light{background:radial-gradient(ellipse,#eda9ca55,transparent 66%)}@keyframes unseal{to{opacity:0;transform:translateX(-80rpx) rotateY(-80deg)}}@keyframes arrive{from{opacity:.3;transform:rotateY(-25deg) scale(.9)}to{opacity:1;transform:rotateY(0) scale(1)}}@keyframes glow{from{opacity:0;transform:scale(.7)}40%{opacity:1}to{opacity:.4}}
/* C theme alignment, preserving card and capture mechanics. */
.new-badge{background:var(--sun);color:var(--ink);font-size:24rpx}.seal{background:var(--ink);color:var(--paper);box-shadow:0 12rpx 30rpx #183f3620}.seal-small{font-size:24rpx;letter-spacing:0;color:var(--paper)}.seal-bottom{font-size:22rpx;letter-spacing:0}.seal-title{font-size:28rpx}.seal-mark{width:92rpx;height:92rpx;border:3rpx solid var(--sun);border-radius:50% 10% 50% 10%;margin:40rpx 0 24rpx;transform:rotate(-22deg)}.arrive{animation-duration:.45s}.light{animation-duration:.45s;animation-fill-mode:forwards;pointer-events:none}.hold-track view{width:100%;transform:scaleX(0);transform-origin:left}.holding .hold-track view{width:100%;transform:scaleX(1);transition:transform .7s linear}.reduce-motion .arrive,.reduce-motion .light,.reduce-motion .seal{animation:none}.reduce-motion .holding .hold-track view{transition:none}@keyframes glow{from{opacity:0;transform:scale(.9)}40%{opacity:1}to{opacity:0;transform:scale(1)}}
