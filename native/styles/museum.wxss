/* Private nature museum: user-approved roles, not decorative page themes. */
page{--paper:#F5F2E9;--surface:#FAF8F1;--ink:#243028;--muted:#586459;--moss:#49634E;--lake:#64869A;--orange:#49634E;--sun:#C99B48;--line:#D8D9CC;--radius-card:16rpx;--radius-action:22rpx;--space-section:48rpx;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:32rpx;line-height:1.55}
.page{padding:32rpx 32rpx calc(172rpx + env(safe-area-inset-bottom))}.title{font-size:48rpx;font-weight:600;line-height:1.25;letter-spacing:0}.section{font-size:36rpx;line-height:1.35;font-weight:600}.sub,.hint{font-size:26rpx;line-height:1.6;color:var(--muted)}.panel{background:var(--surface);border-radius:24rpx;border:1rpx solid var(--line);box-shadow:none}.primary,.secondary{border-radius:var(--radius-action);min-height:88rpx;box-shadow:none}.primary{background:var(--moss);color:var(--surface)}.secondary{background:var(--surface)}.pill.on{background:#E5E9DF;color:var(--ink)}.latin{font-family:Georgia,'Times New Roman',serif;font-style:italic}.notice{background:#EEE7D6}.reduce-motion .primary,.reduce-motion .secondary{transition:none;transform:none}
