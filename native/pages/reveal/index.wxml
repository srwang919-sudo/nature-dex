<view class="page reveal-page {{reduce?'reduce-motion':''}}"><block wx:if="{{card}}"><view wx:if="{{intro}}" class="discovery {{!reduce?'discovery-motion':''}}"><view class="discovery-kicker">一次新的自然相遇</view><view class="discovery-orbit"><view class="discovery-glow"></view><view class="discovery-stars" aria-hidden="true"><view></view><view></view><view></view></view><view class="discovery-photo"><collectible card="{{card}}" scene="{{true}}"/></view></view><view class="discovery-name">{{card.zh}}</view><view class="discovery-latin">{{card.latin}}</view><view class="discovery-title">{{discoveryTitle}} · {{discoveryReward}}</view><view class="discovery-note">确认入册后记录这次收获</view><button class="primary discovery-continue" bindtap="continueDiscovery">查看收藏卡</button><view class="hint">一张卡片，记住一次相遇</view></view><block wx:else><view class="row between"><view><view class="title">{{duplicate?'又遇见你了':'发现新物种！'}}</view><view class="sub">{{duplicate?'已收藏 · 第 '+(duplicate+1)+' 次观察':'首次记录 · 让这次遇见留下来'}}</view></view><text class="new-badge">{{duplicate?'＋1':'新记录'}}</text></view>
<view wx:if="{{card.artStatus==='fallback'}}" class="notice spaced">{{card.artMessage}}</view><view wx:if="{{card.artStatus==='ready'}}" class="notice spaced">AI 艺术卡面 · 原始照片保留 · 不作为鉴别依据</view><view wx:if="{{card.protection}}" class="notice spaced">{{card.protection}}</view><view class="stage {{card.finishKey}}"><view wx:if="{{opened&&!reduce}}" class="light"></view><view class="hero-card {{opened&&!reduce?'arrive':''}}" bindtap="flip"><collectible card="{{card}}" large="{{true}}" back="{{back}}" bind:recordtap="flip" motion="{{opened&&!reduce}}"/></view>
</view>
<view class="hint">{{opened?'轻触卡片翻面 · 让这一刻有迹可循':'正在呈现这次遇见…'}}</view>

<view wx:if="{{opened}}" class="observation"><view class="row between"><text>{{duplicate?'已收藏 · 观察再深入一步':'第一份观察记录'}}</text><text class="green">{{duplicate+1}} 次</text></view><view class="track"><view class="fill" style="width:{{progress}}%"></view></view></view>
<button class="primary spaced" disabled="{{!opened}}" bindtap="collect">{{saved?'返回我的图鉴':'完成 · 收入图鉴'}}</button><view class="row spaced"><button class="secondary grow" disabled="{{!opened}}" bindtap="view">3D 查看</button><button class="secondary grow" bindtap="again">再拍一张</button></view><view class="hint spaced">确认记录 · {{card.finish}} · {{card.artStatus==='ready'?'AI 艺术卡面':'实拍照片'}}</view></block></block><view wx:else class="empty">这张卡暂时无法打开<button class="link" bindtap="again">返回拍摄</button></view></view>
<view wx:if="{{badgeRevealed&&unlockedBadge}}" class="badge-reveal-overlay {{reduce?'reduce-motion':'badge-animate'}}" aria-role="dialog" aria-label="自然勋章已点亮"><view class="badge-reveal-panel"><text class="sub">真实探索 · 勋章已点亮</text><view class="badge-reveal-image"><nature-badge motif="{{unlockedBadge.motif}}" earned="{{true}}" large="{{true}}"/></view><view class="title">{{unlockedBadge.name}}</view><text class="sub">这次真实观察，已留在你的自然图鉴中。</text><button class="primary spaced" bindtap="finishBadge">查看图鉴</button></view></view>
