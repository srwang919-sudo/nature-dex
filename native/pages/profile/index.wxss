.profile-page{padding-top:40rpx}.identity{display:flex;align-items:center;gap:24rpx;padding:16rpx 0 32rpx}.identity-copy{min-width:0;display:flex;flex-direction:column;gap:8rpx}.identity-name{font-family:var(--font-heading);font-size:44rpx;line-height:1.35;overflow-wrap:anywhere}.identity-meta,.observer-tag{font-size:24rpx;color:var(--muted)}.avatar-picker{padding:0;width:136rpx;height:136rpx;min-width:88rpx;min-height:88rpx;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;flex:none;background:var(--color-primary-light);border:1rpx solid var(--line);color:var(--ink);font-size:24rpx}.avatar-image{width:100%;height:100%}
.summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;padding:24rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.summary-grid>view{display:flex;align-items:center;flex-direction:column;gap:8rpx;font-size:24rpx;color:var(--muted)}.summary-grid>view+view{border-left:1rpx solid var(--line)}.summary-number{font:40rpx/1.2 Georgia,serif;color:var(--ink)}
.profile-quote{padding:18rpx 0;font-family:var(--font-heading);font-size:26rpx;color:var(--muted);line-height:1.6;border-bottom:1rpx solid var(--line)}.badges-preview{margin-top:28rpx}.badges-preview-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}.badges-preview-heading .section{font-size:30rpx}.badges-preview-row{display:flex;gap:16rpx;align-items:center}.preview-badge{width:88rpx;height:88rpx;transition:transform .24s cubic-bezier(.22,1,.36,1)}.preview-badge:active{transform:scale(.94)}.profile-links{display:flex;flex-direction:column;margin-top:28rpx;border-top:1rpx solid var(--line)}.profile-links .link-row{display:flex;align-items:center;gap:12rpx;padding:24rpx 0;border-bottom:1rpx solid var(--border);background:transparent;font-size:28rpx}.profile-links .link-row .grow{display:flex;flex-direction:column;gap:4rpx}.profile-links .link-row .sub{font-size:22rpx}.profile-links .arrow{flex:none;color:var(--muted);font-size:28rpx}
.subscription-card{border-top:1rpx solid var(--line);padding-top:28rpx;margin-top:32rpx}.subscription-card>.sub{margin-top:12rpx}.archive-links{display:flex;gap:16rpx;margin-top:24rpx}.archive-links button{flex:1;min-width:0;padding:18rpx 12rpx;font-size:26rpx}.notes-heading{margin-top:36rpx;margin-bottom:16rpx}.empty-notes{padding:24rpx;background:var(--color-surface-2);border-radius:var(--radius-card)}.note-card{display:flex;align-items:center;gap:20rpx;padding:20rpx;margin-top:16rpx;border:1rpx solid var(--line);border-radius:var(--radius-card);background:var(--surface)}.note-thumb{width:112rpx;height:112rpx;border-radius:var(--radius-sm);flex:none}.note-copy{display:flex;flex-direction:column;gap:8rpx;min-width:0}.note-name{font-family:var(--font-heading);font-size:30rpx}.note-text{font-size:24rpx;color:var(--muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.settings-links{display:flex;flex-direction:column;margin-top:36rpx;border-top:1rpx solid var(--line)}.settings-links button{justify-content:space-between;border:0;border-bottom:1rpx solid var(--line);border-radius:0;background:transparent;font-size:28rpx;padding:24rpx 0}.settings-links button::before{content:'›';order:2;color:var(--muted)}.brand-footer{display:flex;flex-direction:column;align-items:center;gap:10rpx;padding:48rpx 0 16rpx;color:var(--muted);font-size:24rpx}
.badge-preview-mask{position:fixed;inset:0;z-index:100;background:rgba(20,43,34,.68);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.badge-preview-panel{width:100%;height:calc(100vh - 140rpx);max-width:660rpx;overflow:auto;padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:var(--radius-card);background:var(--paper);text-align:center}.badge-preview-close{margin-left:auto;min-width:110rpx;min-height:88rpx;font-size:26rpx;background:transparent}.badge-preview-image{display:block;width:380rpx;height:380rpx;max-width:100%;margin:16rpx auto}.badge-preview-panel text{display:block}.badge-preview-rule{font-size:28rpx;line-height:1.6;margin:16rpx 0;overflow-wrap:anywhere}.badge-preview-progress,.badge-preview-state{font-size:26rpx;color:var(--moss);margin:14rpx 0}
.profile-archive-head{margin:6rpx 0 2rpx}
@media(max-width:340px){.identity{gap:16rpx}.identity-name{font-size:38rpx}}
