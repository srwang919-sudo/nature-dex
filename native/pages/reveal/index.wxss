.reveal-page{padding-top:32rpx}.new-badge{background:var(--color-primary-light);color:var(--ink);border-radius:var(--radius-sm);padding:12rpx 18rpx;font-size:24rpx;flex:none}.stage{width:480rpx;max-width:100%;height:672rpx;margin:40rpx auto 24rpx;position:relative}.hero-card{width:100%;height:100%}.arrive,.hero-card.painting{animation:plate-reveal .32s ease-out both}.observation{margin-top:24rpx;font-size:26rpx}.light,.discovery-glow,.discovery-stars{display:none}
@keyframes plate-reveal{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:none}}
.discovery{min-height:calc(100vh - 210rpx);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:28rpx 0 48rpx}.discovery-kicker{font-size:24rpx;color:var(--muted);letter-spacing:2rpx}.discovery-orbit{position:relative;width:100%;height:490rpx;display:flex;align-items:center;justify-content:center;margin:32rpx 0 24rpx}.discovery-photo{width:390rpx;max-width:100%;height:490rpx}.discovery-name{font-family:var(--font-heading);font-size:52rpx;font-weight:600;color:var(--ink);max-width:100%;overflow-wrap:anywhere}.discovery-latin{font:italic 26rpx/1.5 Georgia,serif;color:var(--muted);margin-top:8rpx;overflow-wrap:anywhere}.discovery-title{font-size:28rpx;color:var(--ink);margin-top:26rpx}.discovery-note{font-size:24rpx;color:var(--muted);margin:10rpx 0 28rpx}.discovery-continue{width:100%;margin:10rpx 0 18rpx}.discovery-motion .discovery-photo{animation:plate-reveal .32s ease-out both}
.badge-reveal-overlay{position:fixed;inset:0;z-index:90;background:rgba(20,43,34,.6);display:flex;align-items:center;justify-content:center;padding:40rpx}.badge-reveal-panel{width:100%;max-width:600rpx;padding:40rpx;background:var(--surface);border-radius:var(--radius-lg);text-align:center}.badge-reveal-image{display:block;width:300rpx;height:300rpx;margin:24rpx auto}.badge-animate .badge-reveal-panel{animation:plate-reveal .32s ease-out both}
.reduce-motion .hero-card,.reduce-motion .discovery-photo,.reduce-motion .badge-reveal-panel{animation:none;transform:none}@media(prefers-reduced-motion:reduce){.hero-card,.discovery-photo,.badge-reveal-panel{animation:none;transform:none}}
