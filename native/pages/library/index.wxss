.library-heading .title{font-size:44rpx;color:var(--ink)}.eyebrow{display:block;color:var(--moss);font-size:24rpx;margin-bottom:10rpx}.layout-switch{display:flex;gap:16rpx;margin:28rpx 0}.layout-button{flex:1;min-height:88rpx;border:1rpx solid var(--line);border-radius:24rpx;background:var(--surface);color:var(--ink);font-size:26rpx}.layout-button.selected{background:#E7EBD9;border-color:var(--moss);font-weight:600}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx;align-items:start}.collection-item{min-width:0;min-height:88rpx}.collection-card{width:100%;aspect-ratio:5/7}.collection-card collectible{display:block;width:100%;height:100%}.card-caption{display:block;font-size:24rpx;color:var(--ink);line-height:1.5;padding:10rpx 0;overflow-wrap:anywhere}.puzzle .collection-item:nth-child(4n+2){margin-top:36rpx}.puzzle .collection-item:nth-child(4n+3){width:92%;justify-self:end}.puzzle .collection-item:nth-child(4n+4){width:96%}.library-empty,.footprints-panel{border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface);padding:28rpx 24rpx}.library-empty{text-align:center}.library-empty .sub{display:block;margin:12rpx 0 24rpx}.footprints-panel{margin-top:32rpx}.footprints-panel>.sub{display:block;margin-top:12rpx;line-height:1.6}.footprint-row{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx solid var(--line);padding:22rpx 0;margin-top:14rpx;font-size:26rpx;overflow-wrap:anywhere}.footprint-row>.sub{flex:none}.footprint-empty{padding:10rpx 0}.reduce-motion .collection-item{transition:none;animation:none}
