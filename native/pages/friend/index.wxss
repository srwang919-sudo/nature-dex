/* 好友页：安静的自然社交 */
.friend-tabs{display:flex;gap:8rpx;margin-bottom:24rpx;background:var(--surface-2);border-radius:var(--radius-action);padding:5rpx}
.friend-tab{flex:1;min-height:56rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;color:var(--muted);border-radius:var(--radius-action);transition:background .2s ease,color .2s ease}
.friend-tab.on{background:var(--surface);color:var(--moss);font-weight:600;box-shadow:var(--shadow-sm)}

.friend-banner{position:relative;padding:32rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:var(--radius-card);overflow:hidden;margin-bottom:24rpx}
.friend-banner-copy{position:relative;z-index:1;max-width:70%}
.friend-banner .title{font-family:var(--font-heading);font-size:32rpx;line-height:1.4;margin-bottom:8rpx}
.friend-banner .sub{display:block;position:relative;font-size:24rpx;color:var(--muted);line-height:1.65;margin-bottom:18rpx;max-width:85%}
.friend-invite-btn{width:auto;min-height:64rpx;padding:12rpx 24rpx;font-size:24rpx;position:relative;z-index:1}
.friend-banner-leaf{position:absolute;right:-20rpx;top:-10rpx;width:180rpx;height:180rpx;background:radial-gradient(circle at 60% 40%,rgba(94,143,107,.12),rgba(94,143,107,0) 65%);border-radius:50%}

.friend-section-head{display:flex;align-items:center;justify-content:space-between;margin:32rpx 0 16rpx}
.friend-section-head .section{font-size:30rpx}
.friend-empty{padding:28rpx 24rpx;text-align:center;color:var(--color-text-secondary);background:var(--color-surface-1);border:1rpx dashed var(--color-border);border-radius:var(--radius-lg);font-size:26rpx;line-height:1.65}

.suggestion-row{display:flex;align-items:center;gap:20rpx;padding:22rpx 24rpx;margin-top:16rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);transition:transform .16s cubic-bezier(.22,1,.36,1)}
.suggestion-row:active{transform:scale(.985)}
.suggestion-avatar{width:72rpx;height:72rpx;flex:none;border-radius:50%;border:1rpx solid var(--border)}
.suggestion-avatar.avatar-plant{background:linear-gradient(135deg,#e7c9cf,#c98a9a)}
.suggestion-avatar.avatar-insect{background:linear-gradient(135deg,#e9d7b0,#C98A5A)}
.suggestion-avatar.avatar-aqua{background:linear-gradient(135deg,#bcd3ea,#5B8BC7)}
.follow-btn{flex:none;min-height:56rpx;padding:0 22rpx;font-size:24rpx}

.feed-card{padding:20rpx;margin-top:16rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:var(--radius-card);box-shadow:var(--shadow-sm)}
.feed-header{display:flex;align-items:center;gap:14rpx;margin-bottom:14rpx}
.feed-avatar{width:56rpx;height:56rpx;border-radius:50%;flex:none;border:1rpx solid var(--border)}
.feed-name{display:block;font-family:var(--font-heading);font-size:28rpx}
.feed-photo{width:100%;height:260rpx;border-radius:var(--radius-sm);margin-bottom:12rpx;background-size:cover;background-position:center}
.feed-photo.photo-bird{background:linear-gradient(135deg,#bcd3ea,#5B8BC7)}
.feed-photo.photo-plant{background:linear-gradient(135deg,#e7c9cf,#c98a9a)}
.feed-text{font-size:26rpx;line-height:1.6;color:var(--ink);margin-bottom:12rpx}
.feed-actions{display:flex;gap:16rpx}
.feed-action{font-size:22rpx;color:var(--muted);background:transparent;border:none;padding:6rpx 8rpx;cursor:pointer}
.feed-action.liked{color:var(--moss);font-weight:600}

.friend-row{display:flex;align-items:center;gap:20rpx;padding:22rpx 24rpx;margin-top:16rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);transition:transform .16s cubic-bezier(.22,1,.36,1)}
.friend-row:active{transform:scale(.985)}
.friend-avatar{width:72rpx;height:72rpx;flex:none;border-radius:50%;background:var(--color-primary-light);border:2rpx solid var(--color-border);position:relative}
.friend-avatar::after{content:'';position:absolute;left:50%;top:16rpx;width:24rpx;height:24rpx;margin-left:-12rpx;border-radius:50%;background:var(--color-primary);opacity:.55}
.friend-enter{flex:none;font-size:24rpx;color:var(--color-primary)}
.memory-row{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx;padding:22rpx 24rpx;margin-top:16rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm)}
.memory-seal{width:56rpx;height:56rpx;flex:none;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--color-accent);box-shadow:var(--shadow-sm)}
.memory-row .secondary{min-height:64rpx;padding:0 22rpx;font-size:24rpx}
.request-row{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:1rpx solid var(--color-border);font-size:26rpx}
.invite-panel{padding:26rpx 24rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg)}
.invite-panel>.sub{display:block;margin-top:8rpx}
.friend-input{min-height:var(--tap-min);padding:0 20rpx;border:1rpx solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface-2);font-size:28rpx;box-sizing:border-box}

.suggestion-row>.grow,.memory-row>.grow,.request-row>.grow,.feed-header>.grow{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}
.suggestion-row .sub,.feed-header .sub,.friend-row .sub{display:block}
.memory-actions{display:flex;width:100%;gap:16rpx;padding-top:16rpx;border-top:1rpx solid var(--line)}
.memory-actions button{flex:1;min-width:0;margin:0}
.request-row .grow{overflow-wrap:anywhere}

.reduce-motion .friend-row:active,.reduce-motion .suggestion-row:active{transform:none}
@media(max-width:340px){.friend-banner .title{font-size:28rpx}.feed-photo{height:220rpx}}
