.explore-top{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.brand{font-size:34rpx;font-weight:600;color:var(--ink)}.explore-top .sub{font-size:22rpx}
.exploration-intro{position:relative;display:flex;align-items:center;min-height:250rpx;margin:24rpx 0}.intro-copy{position:relative;z-index:1;max-width:72%}.intro-copy .sub{display:block;margin-top:16rpx}.nature-shapes{position:absolute;right:0;bottom:4rpx;width:210rpx;height:220rpx;overflow:hidden}.sun{position:absolute;right:12rpx;top:8rpx;width:64rpx;height:62rpx;background:var(--sun);border-radius:47% 53% 45% 55%}.stem{position:absolute;left:80rpx;bottom:12rpx;width:5rpx;height:142rpx;background:var(--moss);transform:rotate(12deg)}.leaf{position:absolute;width:70rpx;height:37rpx;border-radius:90% 10% 80% 10%;background:var(--moss)}.leaf-a{left:22rpx;bottom:69rpx;transform:rotate(38deg)}.leaf-b{left:83rpx;bottom:100rpx;transform:rotate(-20deg);background:#8A9959}.flower{position:absolute;right:17rpx;bottom:25rpx;width:58rpx;height:58rpx;border-radius:39% 50% 42% 50%;background:#D88865;transform:rotate(18deg)}.flower view{position:absolute;left:21rpx;top:21rpx;width:16rpx;height:16rpx;border-radius:50%;background:var(--sun)}.hill{position:absolute;left:30rpx;bottom:-22rpx;width:190rpx;height:46rpx;border-radius:50%;background:#D7DFBF}
.task-paper{padding:24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:28rpx}.task-label{color:var(--moss);font-size:24rpx;font-weight:600}.task-count{font-size:24rpx;color:var(--ink)}.task-title{margin:14rpx 0 12rpx}.album-entry{display:flex;align-items:center;justify-content:center;min-height:88rpx;background:none;color:var(--ink);font-size:26rpx}.today-heading{margin-top:24rpx}.today-heading .link{font-size:24rpx;flex:none}.today-scroll{width:100%;height:310rpx}.today-strip{display:flex;gap:16rpx;padding:4rpx 0 18rpx}.today-card{width:200rpx;height:280rpx;flex:none}.today-card collectible{display:block;width:100%;height:100%}.today-empty{padding:28rpx 0;display:flex;flex-direction:column;gap:10rpx;align-items:center;text-align:center;color:var(--ink)}.empty-seed{width:30rpx;height:20rpx;border:2rpx solid var(--moss);border-radius:90% 10%;transform:rotate(-25deg)}.habitat-entry{display:flex;justify-content:space-between;align-items:center;gap:24rpx;border-top:1rpx solid var(--line);padding:28rpx 0;margin-top:16rpx;min-height:120rpx}.habitat-entry .sub{display:block;margin-top:8rpx}.habitat-arrow{color:#285F71;font-size:24rpx;flex:none}
.exploration-intro{display:block;min-height:0;margin:32rpx -32rpx 0;padding-top:0}.intro-copy{max-width:none;padding:0 32rpx}.intro-copy .title{font-size:50rpx;line-height:1.2}.intro-copy .title>view{display:inline}.intro-copy .title>view+view{margin-left:8rpx}.exploration-hero{display:block;position:relative;width:100%;height:330rpx;margin-top:12rpx;overflow:hidden;background:#F1EEDC;border-top:1rpx solid #E3DDC9;border-bottom:1rpx solid #D7D4BF}.hero-sun{position:absolute;right:74rpx;top:34rpx;width:72rpx;height:72rpx;border-radius:50%;background:var(--sun)}.hero-hill{position:absolute;left:-8%;width:116%;border-radius:50% 50% 0 0}.hero-hill-back{height:180rpx;bottom:-84rpx;background:#D8E2C3;transform:rotate(-4deg)}.hero-hill-front{height:132rpx;bottom:-76rpx;background:#B7C99B;transform:rotate(3deg)}.hero-plant{position:absolute;right:170rpx;bottom:30rpx;width:210rpx;height:245rpx}.hero-stem{position:absolute;left:103rpx;bottom:0;width:12rpx;height:210rpx;border-radius:12rpx;background:#2F6659;transform:rotate(8deg)}.hero-leaf{position:absolute;width:104rpx;height:64rpx;border-radius:88% 12% 82% 18%;background:#6F8750}.hero-leaf-a{left:6rpx;bottom:58rpx;transform:rotate(30deg)}.hero-leaf-b{right:0;bottom:118rpx;transform:rotate(-25deg);background:#8EA05F}.hero-leaf-c{left:20rpx;bottom:148rpx;transform:rotate(40deg);background:#496F51}.task-paper{position:relative;margin-top:-24rpx;border-radius:30rpx;background:var(--surface);border:1rpx solid #DED8C6;padding:26rpx;box-shadow:0 6rpx 0 #E9E3D2}.task-paper .primary{margin-top:20rpx}.task-paper .album-entry{min-height:80rpx}.task-label{display:inline-flex;align-items:center;font-weight:600;color:var(--ink);background:#E8EDDA;padding:8rpx 16rpx;border-radius:40rpx}.task-title{font-size:32rpx}.today-empty{margin:8rpx 0 24rpx;border:1rpx dashed #C9D1B8;border-radius:26rpx;background:#F2F2E2;padding:28rpx}.habitat-entry{background:#E5EFF0;border:0;border-radius:26rpx;padding:24rpx}.habitat-entry .section{font-size:30rpx}
.record-area{position:relative;display:flex;flex-direction:column;align-items:center;gap:20rpx;margin:-34rpx 0 30rpx;z-index:2;text-align:center}.home-record{width:190rpx;height:190rpx;min-height:190rpx;border:8rpx solid var(--paper);border-radius:50%;background:var(--orange);color:var(--paper);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;font-size:28rpx;font-weight:600;padding:16rpx;box-shadow:0 5rpx 0 #D9C4AB;transition:transform .2s cubic-bezier(.22,1,.36,1)}.home-record:active{transform:scale(.97)}.record-camera{width:58rpx;height:43rpx;border:4rpx solid currentColor;border-radius:9rpx;position:relative}.record-camera:before{content:'';position:absolute;left:17rpx;top:8rpx;width:18rpx;height:18rpx;border:3rpx solid currentColor;border-radius:50%}.record-camera:after{content:'';position:absolute;left:16rpx;top:-11rpx;width:20rpx;height:8rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:5rpx 5rpx 0 0}.record-area+.task-paper{margin-top:0}.reduce-motion .home-record{transition:none;transform:none}@media(prefers-reduced-motion:reduce){.home-record{transition:none}.home-record:active{transform:none}}
.return-top{position:fixed;right:24rpx;bottom:calc(180rpx + env(safe-area-inset-bottom));z-index:19;min-height:88rpx;padding:20rpx 24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:40rpx;color:var(--ink);font-size:24rpx}
