.physical{position:relative;width:100%;height:100%;box-sizing:border-box;background:#fffdf7;border:2rpx solid #d4c9b6;box-shadow:0 2px 5px #18222a0a,0 8px 20px #18222a12;overflow:hidden}.inner{height:100%;position:relative;display:flex;flex-direction:column;overflow:hidden}.photo{width:100%;height:0;flex:1;min-height:0}.metadata{height:68rpx;flex:none;padding:0 12rpx;display:flex;flex-direction:column;justify-content:center;background:#fffbf2;position:relative;border-top:2rpx solid #d8d0c1;z-index:2}.name-row{display:flex;align-items:center;justify-content:space-between;gap:4rpx}.name{font-size:23rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;color:#17352d}.stars{font-size:13rpx;color:#9a6e19;white-space:nowrap;letter-spacing:1rpx}.latin{display:block;color:#58655d;font-size:14rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.anchor{position:absolute;top:10rpx;left:9rpx;right:9rpx;display:flex;justify-content:space-between;gap:4rpx;z-index:3}.number,.badge{font-size:13rpx;padding:5rpx 8rpx;border-radius:30rpx;background:#fffbf2ed;white-space:nowrap;color:#41505b;border:1rpx solid #ded0bb}.badge{background:#eef4ed;color:#276854}.holo{padding:3rpx;background:linear-gradient(135deg,#7fa9e8,#a98ce8 44%,#efc46a)}.holo .metadata{background:#e6f2ed;border-color:#8ebbad}.holo .badge,.holo .number{background:#e6f2edf0;color:#176a58}.alt{padding:3rpx;background:linear-gradient(135deg,#c86f65,#9586bd)}.alt .metadata{background:#f8ebe1;border-color:#d8a699}.alt .badge,.alt .number{background:#f8ebe1f0;color:#934837}.numbered{padding:3rpx;background:linear-gradient(135deg,#e2c078,#fff3d6 46%,#d3ac5c)}.numbered .metadata{background:#fff5dc;border-color:#d7b66d}.numbered .number,.numbered .badge{background:#fff5dcf0;color:#7a5a12}.sample{position:absolute;bottom:76rpx;left:10rpx;color:#fff;font-size:15rpx;background:#1b2a3380;padding:3rpx 8rpx}.large .metadata{height:120rpx;padding:0 24rpx}.large .name{font-size:39rpx}.large .stars{font-size:21rpx}.large .latin{font-size:19rpx}.large .anchor{top:16rpx;left:16rpx;right:16rpx}.large .number,.large .badge{font-size:19rpx;padding:7rpx 13rpx}.large .sample{bottom:132rpx;font-size:19rpx}.shine{pointer-events:none;position:absolute;top:-35%;left:-90%;width:70%;height:150%;transform:rotate(25deg);background:linear-gradient(90deg,transparent,#ffffff66,transparent);opacity:0;z-index:1}.moving.holo .shine,.moving.alt .shine,.moving.numbered .shine{animation:foil 4s ease-in-out infinite}.large.numbered{box-shadow:0 12px 35px #b58b3c40}.back{height:100%;box-sizing:border-box;padding:22rpx 27rpx 18rpx;background:#fffbf2;display:flex;flex-direction:column;color:#17352d;overflow:hidden;position:relative}.back::after{content:'';position:absolute;inset:8rpx;border:1rpx solid #e1d8c7;pointer-events:none}.back-top{position:relative;z-index:2;display:flex;justify-content:space-between;gap:12rpx;flex:none;font-size:20rpx;line-height:1.4;padding-bottom:11rpx;border-bottom:1rpx solid #d9d0c1;letter-spacing:1rpx}.back-brand{color:#58655d}.back-illustration{position:absolute;z-index:0;right:-12rpx;bottom:42rpx;width:260rpx;height:260rpx;opacity:.22;pointer-events:none}.species-illustration{display:block;width:100%;height:100%}.art-fallback{height:100%;display:flex;align-items:center;justify-content:center;color:#2f6659;font-size:156rpx;line-height:1}.record-content{position:relative;z-index:1;padding:13rpx 8rpx 0 0;flex:1;min-height:0;overflow:hidden}.back-name{display:block;font-size:39rpx;font-weight:500;line-height:1.15;white-space:normal;word-break:break-all;color:#17352d}.back-latin{display:block;font-size:20rpx;line-height:1.35;white-space:normal;overflow-wrap:anywhere;color:#58655d;margin-top:6rpx;font-style:italic}.record-field{margin-top:15rpx;max-width:78%}.record-label{display:block;font-size:19rpx;line-height:1.3;color:#58655d;letter-spacing:1rpx}.record-value{display:block;margin-top:3rpx;font-size:23rpx;line-height:1.38;color:#17352d;white-space:normal;word-break:break-all}.protection-field{position:relative;z-index:2;flex:none;padding:10rpx 0 8rpx;border-top:1rpx solid #d9d0c1;background:#fffbf2e8}.protection-field .record-value{font-size:21rpx}.back-bottom{position:relative;z-index:2;flex:none;border-top:1rpx solid #d9d0c1;padding-top:9rpx;font-size:19rpx;line-height:1.25;color:#58655d;background:#fffbf2e8}.record-footer-line{display:flex;flex-wrap:wrap;gap:6rpx 14rpx;justify-content:space-between}.record-serial{display:block;word-break:break-all;margin-top:3rpx;font-size:18rpx}@keyframes foil{0%,30%{left:-100%;opacity:0}40%{opacity:.8}70%,100%{left:160%;opacity:0}}
.photo-fallback{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;background:#ece7d9;color:#5d675e;font-size:21rpx;letter-spacing:1rpx}
.back-family{display:block;margin-top:5rpx;font-size:18rpx;line-height:1.3;color:#7a857d;letter-spacing:.5rpx}
.back-tagline{margin-top:13rpx;padding:9rpx 13rpx;border-left:4rpx solid #78aa8f;background:#f2efe4;border-radius:0 10rpx 10rpx 0;max-width:82%}
.back-tagline-copy{font-family:'Kaiti SC','STKaiti','PingFang SC',serif;font-size:21rpx;line-height:1.4;color:#2f6659;display:block}
.fact-item{margin-top:12rpx}
.fact-item .record-label{font-size:19rpx}
.fact-title{display:block;margin-top:2rpx;font-size:23rpx;line-height:1.35;font-weight:500;color:#17352d}
.fact-detail{display:block;margin-top:2rpx;font-size:19rpx;line-height:1.4;color:#58655d;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.knowledge-field{margin-top:13rpx;padding:10rpx 12rpx;background:#f7f4ea;border-radius:12rpx;max-width:96%}
.knowledge-field .record-label{font-size:19rpx}
.knowledge-value{display:block;margin-top:3rpx;font-size:19rpx;line-height:1.45;color:#31453f;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.stats-row{display:flex;gap:9rpx;margin-top:13rpx;max-width:96%}
.stats-cell{flex:1;min-width:0;display:flex;flex-direction:column;gap:2rpx;align-items:center;text-align:center;padding:8rpx 4rpx;background:#f2efe4;border-radius:12rpx}
.stats-val{font-family:'DIN Alternate','PingFang SC',sans-serif;font-size:20rpx;font-weight:600;color:#174f42;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
.stats-key{font-size:16rpx;color:#7a857d;white-space:nowrap}
.record-content{padding:13rpx 8rpx 0 0}
.record-field{margin-top:11rpx}
.back-illustration{opacity:.22}
.back-art{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
.back-illustration-full{width:100%;height:100%}
.back .back-bottom{background:transparent;border-top:1rpx solid #d9d0c1;color:#8a938c}
.back .record-footer-line{justify-content:center;letter-spacing:1rpx}
