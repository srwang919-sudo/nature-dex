/* 底部主导航 · 贴底栏
   与 .page 的 184rpx 底部留白配套。此文件曾同时存在「浮动胶囊」与「贴底栏」
   两套设计并互相覆盖，现只保留贴底栏，避免样式来源不明。 */
.dock{position:fixed;bottom:0;left:0;right:0;z-index:20;padding:8rpx 16rpx calc(8rpx + env(safe-area-inset-bottom));background:var(--color-bg);border-top:1rpx solid var(--color-border);pointer-events:none}
.tabs{height:112rpx;display:flex;pointer-events:auto}
.tab{position:relative;flex:1;min-width:0;min-height:96rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;font-family:'PingFang SC',sans-serif;font-size:26rpx;color:var(--color-text-secondary);transition:color .18s ease}
/* 选中态三重信号：品牌色 + 加粗 + 图标底块。不只靠颜色传达当前页面。 */
.tab.on{color:var(--color-primary);font-weight:600}
.tab.on .icon-wrap{background:var(--color-primary-light)}
.icon-wrap{width:68rpx;height:48rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;transition:background .18s ease}
.tab-label{line-height:1.3}
.reduce-motion .tab,.reduce-motion .icon-wrap{transition:none}

/* ---- 图标：纯 CSS 手绘，随文字色继承，不额外引入图片 ---- */
.icon{position:relative;width:32rpx;height:30rpx;color:inherit;box-sizing:border-box}
.book{border:3rpx solid currentColor;border-radius:4rpx}.book::after{content:'';position:absolute;left:12rpx;top:0;bottom:0;border-left:2rpx solid currentColor}
.leaf{border:3rpx solid currentColor;border-radius:100% 0 100% 0;transform:rotate(-38deg);width:26rpx;height:30rpx}.leaf::after{content:'';position:absolute;left:10rpx;top:5rpx;height:24rpx;border-left:2rpx solid currentColor;transform:rotate(38deg)}
.person::before{content:'';position:absolute;left:10rpx;top:0;width:12rpx;height:12rpx;border:3rpx solid currentColor;border-radius:50%}.person::after{content:'';position:absolute;left:3rpx;bottom:0;width:26rpx;height:11rpx;border:3rpx solid currentColor;border-radius:14rpx 14rpx 4rpx 4rpx}
.trail{border:2rpx dashed currentColor;border-radius:50%;width:32rpx;height:30rpx;transform:rotate(-30deg)}.trail::after{content:'';position:absolute;width:7rpx;height:7rpx;background:currentColor;border-radius:50%;right:-1rpx;top:0}
/* 好友：两个人形圆点 */
.friends::before{content:'';position:absolute;left:3rpx;top:1rpx;width:13rpx;height:13rpx;border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box}
.friends::after{content:'';position:absolute;right:1rpx;top:7rpx;width:11rpx;height:11rpx;border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box;background:var(--color-bg)}
