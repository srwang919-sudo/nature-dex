.privacy-mask{position:fixed;inset:0;z-index:9999;background:rgba(16,35,29,.65);display:flex;align-items:center;justify-content:center;padding:36rpx;box-sizing:border-box}.privacy-dialog{width:100%;max-height:80vh;overflow:auto;padding:36rpx;border-radius:28rpx;background:#FAF9F6;box-sizing:border-box;color:#173F35}.privacy-title{font-size:34rpx;font-weight:600;line-height:1.4}.privacy-copy{font-size:27rpx;line-height:1.7;margin:24rpx 0;color:#53675C}.privacy-button{min-height:88rpx;display:flex;align-items:center;justify-content:center;margin:16rpx 0 0;font-size:28rpx;line-height:1.5;border-radius:18rpx;padding:16rpx}.privacy-button::after{border:none}.privacy-link,.privacy-decline{color:#173F35;background:transparent}.privacy-agree{color:#fff;background:#173F35}
