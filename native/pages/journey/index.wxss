/* 旅程 = 一张探索地图：路线、节点、地标、罗盘概览 */
.journey-page>.title{margin-top:8rpx}
.journey-empty{padding:72rpx 0;max-width:620rpx}
.journey-empty>.sub{display:block;margin-top:24rpx}

/* ---- 罗盘概览 ---- */
.journey-compass{display:flex;justify-content:space-around;gap:16rpx;margin-top:32rpx;padding:24rpx 16rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm)}
.compass-cell{display:flex;flex-direction:column;align-items:center;gap:6rpx;font-size:22rpx;color:var(--color-text-secondary);min-width:0}
.compass-cell .number{font-size:40rpx;color:var(--color-text);line-height:1.1}

/* ---- 地图底图 ---- */
.journey-map{margin-top:32rpx;padding:28rpx 24rpx;background:linear-gradient(180deg,#F8F9F5,#F1F5EC);border:1rpx solid var(--color-border);border-radius:var(--radius-xl);box-shadow:var(--shadow-sm)}
.map-legend{display:flex;flex-wrap:wrap;gap:24rpx;margin-bottom:8rpx;font-size:22rpx;color:var(--color-text-secondary)}
.legend-item{display:flex;align-items:center;gap:8rpx}
.legend-dot{width:16rpx;height:16rpx;border-radius:50%;background:var(--color-primary)}
.legend-dot.current{background:var(--color-accent)}
.legend-dot.landmark{border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--color-accent)}

/* ---- 单条探索路线 ---- */
.map-route{margin-top:28rpx}
.route-head{display:flex;align-items:center;gap:20rpx}
.route-portrait{width:112rpx;height:156rpx;flex:none;border-radius:var(--radius-md);overflow:hidden;border:1rpx solid var(--color-border);background:var(--color-surface-1)}
.route-portrait collectible{display:block;width:100%;height:100%}
.route-copy{flex:1;min-width:0;overflow-wrap:anywhere}
.route-copy .sub{display:block;margin-top:4rpx}

/* 路径主线 + 节点 */
.route-path{position:relative;margin:18rpx 0 0 68rpx;padding-left:40rpx}
.route-path::before{content:'';position:absolute;left:0;top:20rpx;bottom:20rpx;width:4rpx;border-radius:2rpx;background:linear-gradient(180deg,var(--color-accent),var(--color-primary))}
.path-node{position:relative;display:flex;align-items:center;gap:14rpx;min-height:76rpx;padding:0 4rpx}
.path-node::before{content:'';position:absolute;left:-40rpx;top:50%;width:40rpx;height:2rpx;background:var(--color-primary);opacity:.45}
.node-dot{position:absolute;left:-52rpx;top:50%;width:24rpx;height:24rpx;margin-top:-12rpx;border-radius:50%;background:var(--color-primary);border:4rpx solid var(--color-surface-1);box-shadow:0 0 0 2rpx rgba(74,124,89,.22)}
.path-node.is-current .node-dot{background:var(--color-accent);box-shadow:0 0 0 2rpx rgba(212,165,116,.32)}
.path-node.is-current .node-dot::after{content:'';position:absolute;inset:-10rpx;border-radius:50%;border:2rpx solid var(--color-accent);animation:node-pulse 2.2s ease-out infinite}
.node-date{font-size:26rpx;color:var(--color-text);min-width:0;overflow-wrap:anywhere}
.node-link{margin-left:auto;flex:none;font-size:22rpx;color:var(--color-primary)}
@keyframes node-pulse{0%{opacity:.85;transform:scale(.7)}70%{opacity:0;transform:scale(1.7)}100%{opacity:0;transform:scale(1.7)}}
.reduce-motion .node-dot::after{animation:none;opacity:0}

/* ---- 地标（走过的地点）---- */
.landmark-panel{margin-top:32rpx;padding:24rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg)}
.landmark-panel>.sub{display:block;margin-top:8rpx}
.landmark{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:1rpx solid var(--color-border);font-size:26rpx;overflow-wrap:anywhere}
.landmark:first-of-type{border-top:0;margin-top:12rpx}
.landmark-marker{width:32rpx;height:32rpx;flex:none;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--color-accent);border:2rpx solid var(--color-surface-1);box-shadow:var(--shadow-sm)}
.landmark-count{margin-left:auto;flex:none;color:var(--color-text-secondary);font-size:24rpx}

@media(max-width:340px){.route-portrait{width:96rpx;height:134rpx}.route-path{margin-left:56rpx;padding-left:32rpx}.path-node::before{left:-32rpx;width:32rpx}.node-dot{left:-44rpx}}
