.physical{position:relative;width:100%;height:100%;box-sizing:border-box;padding:10rpx;background:var(--color-surface-1,#FCFAF5);border:1rpx solid var(--color-border,#DAD5C9);border-radius:24rpx;overflow:hidden;color:var(--color-text,#26382F);box-shadow:0 4rpx 12rpx rgba(38,56,47,.05)}
.inner{height:100%;position:relative;display:flex;flex-direction:column;overflow:hidden}
.photo{width:100%;height:0;flex:1;min-height:0;border-radius:16rpx;display:block}
.photo-fallback{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;background:#E7E5DB;color:#66756B;font-size:24rpx;text-align:center}
.metadata{flex:none;min-height:108rpx;padding:16rpx 6rpx 8rpx;display:flex;flex-direction:column;justify-content:center;gap:5rpx;box-sizing:border-box}
.name-row{min-width:0}.name{display:block;font-family:var(--font-heading,'Songti SC',serif);font-size:30rpx;font-weight:600;line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.latin{display:block;font-family:Georgia,serif;font-style:italic;color:var(--color-text-secondary,#66756B);font-size:24rpx;line-height:1.45;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.front-context{display:flex;flex-wrap:wrap;gap:4rpx 12rpx;justify-content:space-between;margin-top:8rpx;padding-top:8rpx;border-top:1rpx solid var(--color-border,#DAD5C9);font-size:24rpx;line-height:1.4;color:var(--color-text-secondary,#66756B)}
.front-context-item{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.expanded-metadata{min-height:164rpx}.large{padding:16rpx}.large .metadata{padding:22rpx 12rpx 12rpx;min-height:146rpx}.large .expanded-metadata{min-height:192rpx}.large .name{font-size:40rpx}.large .latin,.large .front-context{font-size:24rpx}
.sample{position:absolute;left:12rpx;top:12rpx;padding:4rpx 10rpx;font-size:24rpx;background:var(--surface,#FCFAF5);border-radius:16rpx}
.back{height:100%;display:flex;flex-direction:column;box-sizing:border-box;gap:12rpx}.back-art{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:16rpx;font-size:24rpx;text-align:center;color:var(--muted,#66756B)}.back-illustration-full{width:100%;height:100%;display:block}.original-label{display:block;font-size:24rpx;text-align:center;color:var(--muted,#66756B)}.back-bottom{padding:10rpx 0;border-top:1rpx solid var(--line,#DAD5C9);font-size:24rpx;color:var(--muted,#66756B)}.record-footer-line{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8rpx}
.scene-art{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0}.scene-image{width:100%;height:0;min-height:0;flex:1;mix-blend-mode:multiply}.scene-name{display:block;max-width:100%;font-size:24rpx;line-height:1.4;color:#26382F;text-align:center;overflow-wrap:anywhere}.scene-unavailable{flex:1;width:65%;height:65%;opacity:.7}
.specimen-footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:4rpx 12rpx;font-size:22rpx;color:var(--muted,#5E6B60);line-height:1.4;margin-top:8rpx;overflow-wrap:anywhere}.specimen-story{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:24rpx;line-height:1.5;color:var(--muted,#5E6B60);margin-top:8rpx}
.photo-only{padding:0;border:0;box-shadow:none}.photo-only .back{gap:0}.photo-only .original-label,.photo-only .back-bottom{display:none}
