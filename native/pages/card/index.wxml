<view class="page {{reduce?'reduce-motion':''}}"><block wx:if="{{card}}"><view class="row between"><view><view class="title">{{card.zh}}</view><view class="sub">{{card.latin}}</view></view><button class="link" bindtap="backToLibrary">返回</button></view><view class="detail-card spaced" bindtap="view"><collectible card="{{card}}" large="{{true}}" motion="{{!reduce}}"/></view><button class="secondary spaced" bindtap="view">展开 3D 卡片 ↗</button><view wx:if="{{isSample}}" class="notice spaced">参考资料卡 · 用于欣赏卡面，不计入你的真实收藏。</view><view class="panel spaced"><view class="section">自然博物志</view><view wx:if="{{card.family}}" class="fact-row"><text class="muted">分类</text><text>{{card.family}}</text></view><view wx:if="{{card.tagline}}" class="science"><view class="sub">观察札记</view><text>{{card.tagline}}</text></view><view wx:if="{{card.note}}" class="science"><view class="sub">观察手记</view><text>{{card.note}}</text></view><view wx:for="{{card.facts}}" wx:key="title" class="science"><view class="sub">识别与行为 · {{index+1}}</view><text>{{item.title}}</text><view>{{item.detail}}</view></view><view wx:if="{{card.knowledge}}" class="science"><view class="sub">你知道吗</view><text>{{card.knowledge}}</text></view><view wx:for="{{card.stats}}" wx:key="label" class="fact-row"><text class="muted">{{item.label}}</text><text>{{item.value}}</text></view><view wx:if="{{card.season}}" class="fact-row"><text class="muted">可见季节</text><text>{{card.season}}</text></view><view class="fact-row"><text class="muted">栖息环境</text><text>{{card.habitat || '资料尚未补充'}}</text></view><view class="fact-row"><text class="muted">IUCN 评估</text><text>{{card.iucn || '暂无评估资料'}}</text></view><view class="fact-row"><text class="muted">卡面工艺</text><text>{{card.finish}}</text></view><view class="sub">{{card.protection || '保持距离观察，不捕捉、不惊扰。'}}保护信息为参考资料，实际观察请遵守当地规定。</view></view><view class="panel spaced"><view class="section">分享与实体收藏</view><view class="sub spaced">微信分享仅发送物种资料，不携带你的照片、卡片编号或私人笔记。</view><button class="secondary spaced" open-type="share">分享物种资料</button><button class="primary spaced" disabled="{{exporting}}" bindtap="exportMenu">{{exporting?'正在生成图片…':'导出含照片分享图 / 打印 PNG'}}</button><view class="sub spaced">打印目标：300dpi · 3mm 出血 · 821×1121px；裁切区 750×1050px。PDF / 实体下单待开放。</view><view wx:if="{{printQuality}}" class="notice spaced">{{printQuality}}</view><view wx:if="{{exportPath}}"><view class="notice spaced">图片已在本机生成，含你选择的照片。确认内容后再保存或转发。</view><view class="row spaced"><button class="secondary grow" bindtap="previewExport">预览图片</button><button class="primary grow" bindtap="saveExport">保存到相册</button></view><button wx:if="{{saveDenied}}" class="secondary spaced" bindtap="openPhotoSettings">打开相册权限设置</button></view></view><view wx:if="{{!isSample}}" class="panel spaced"><view class="section">我的观察笔记</view><textarea class="note" value="{{note}}" bindinput="edit" maxlength="500" placeholder="当时的天气、动作，或一点小发现…"/><button class="secondary" bindtap="save">保存笔记</button></view><button wx:else class="primary spaced" bindtap="shoot">拍下我的第一张</button><button wx:if="{{!isSample}}" class="secondary spaced danger" bindtap="removeCard">删除这张卡</button></block><view wx:else class="empty">没有找到这张卡<button class="link" bindtap="backToLibrary">返回图鉴</button></view></view>
<view wx:if="{{viewer&&card}}" class="modal" catchtouchmove="noop"><view class="mask"></view><button class="close" bindtap="details">×</button><view class="showcase"><view class="scene {{dragging?'dragging':'resting'}}" bindtouchstart="start" catchtouchmove="move" bindtouchend="end" bindtouchcancel="cancel" bindtap="tap" style="transform:perspective(1400rpx) rotateX({{rx}}deg) rotateY({{ry}}deg) translateZ(0)"><view class="flipper {{flipStage}} {{reduce?'reduced':''}}" style="transform:rotateY({{turn}}deg) translateZ(0)"><collectible card="{{card}}" large="{{true}}" back="{{back}}" bind:recordtap="flip" motion="{{!reduce&&!flipping&&!dragging}}"/></view></view><view class="white-hint">{{back?'轻点翻面 · 回到卡面':'轻点翻面 · 看手绘版插画'}}</view><view class="row"><button class="secondary grow" disabled="{{flipping}}" bindtap="flip">↻ 翻面</button><button class="secondary grow" bindtap="details">关闭查看</button></view><view wx:if="{{isSample}}" class="white-hint">参考资料卡 · 不计入收藏</view></view></view>
<canvas id="exportCanvas" type="2d" style="position:fixed;left:-9999px;top:0;width:{{exportWidth}}px;height:{{exportHeight}}px;" disable-scroll="{{true}}"></canvas>
