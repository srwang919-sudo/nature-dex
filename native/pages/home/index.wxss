.explore-top{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.brand{font-size:34rpx;font-weight:600;color:var(--ink)}.explore-top .sub{font-size:22rpx}
.exploration-intro{position:relative;display:flex;align-items:center;min-height:250rpx;margin:24rpx 0}.intro-copy{position:relative;z-index:1;max-width:72%}.intro-copy .sub{display:block;margin-top:16rpx}.nature-shapes{position:absolute;right:0;bottom:4rpx;width:210rpx;height:220rpx;overflow:hidden}.sun{position:absolute;right:12rpx;top:8rpx;width:64rpx;height:62rpx;background:var(--sun);border-radius:47% 53% 45% 55%}.stem{position:absolute;left:80rpx;bottom:12rpx;width:5rpx;height:142rpx;background:var(--moss);transform:rotate(12deg)}.leaf{position:absolute;width:70rpx;height:37rpx;border-radius:90% 10% 80% 10%;background:var(--moss)}.leaf-a{left:22rpx;bottom:69rpx;transform:rotate(38deg)}.leaf-b{left:83rpx;bottom:100rpx;transform:rotate(-20deg);background:#8A9959}.flower{position:absolute;right:17rpx;bottom:25rpx;width:58rpx;height:58rpx;border-radius:39% 50% 42% 50%;background:#D88865;transform:rotate(18deg)}.flower view{position:absolute;left:21rpx;top:21rpx;width:16rpx;height:16rpx;border-radius:50%;background:var(--sun)}.hill{position:absolute;left:30rpx;bottom:-22rpx;width:190rpx;height:46rpx;border-radius:50%;background:#D7DFBF}
.task-paper{padding:24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:28rpx}.task-label{color:var(--moss);font-size:24rpx;font-weight:600}.task-count{font-size:24rpx;color:var(--ink)}.task-title{margin:14rpx 0 12rpx}.album-entry{display:flex;align-items:center;justify-content:center;min-height:88rpx;background:none;color:var(--ink);font-size:26rpx}.today-heading{margin-top:24rpx}.today-heading .link{font-size:24rpx;flex:none}.today-scroll{width:100%;height:310rpx}.today-strip{display:flex;gap:16rpx;padding:4rpx 0 18rpx}.today-card{width:200rpx;height:280rpx;flex:none}.today-card collectible{display:block;width:100%;height:100%}.today-empty{padding:28rpx 0;display:flex;flex-direction:column;gap:10rpx;align-items:center;text-align:center;color:var(--ink)}.empty-seed{width:30rpx;height:20rpx;border:2rpx solid var(--moss);border-radius:90% 10%;transform:rotate(-25deg)}.habitat-entry{display:flex;justify-content:space-between;align-items:center;gap:24rpx;border-top:1rpx solid var(--line);padding:28rpx 0;margin-top:16rpx;min-height:120rpx}.habitat-entry .sub{display:block;margin-top:8rpx}.habitat-arrow{color:#285F71;font-size:24rpx;flex:none}
