/* 探索页：私人自然博物馆入口 */
.explore-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin-bottom:24rpx}
.explore-tools{display:flex;flex-direction:column;align-items:flex-end;gap:12rpx;flex:none}
.explore-compass{width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center}
.compass-icon{width:34rpx;height:34rpx;border:2rpx solid var(--moss);border-radius:50%;position:relative}
.compass-icon::before{content:'';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:4rpx;height:20rpx;background:var(--moss);clip-path:polygon(50% 0,100% 70%,50% 100%,0 70%)}
.explore-brand{min-width:0;flex:1;display:flex;flex-direction:column;gap:4rpx}
.explore-brand .brand{font-family:var(--font-heading);font-size:38rpx;font-weight:600;letter-spacing:1rpx;color:var(--ink)}
.explore-brand .brand-en{font:20rpx/1.4 Georgia,serif;letter-spacing:5rpx;color:var(--muted);margin-top:2rpx}
.explore-brand .brand-tag{font-size:24rpx;color:var(--muted);margin-top:10rpx;line-height:1.5;max-width:32ch}
.explore-camera{width:88rpx;height:88rpx;flex:none;border-radius:50%;background:var(--color-primary);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-sm);transition:transform .24s cubic-bezier(.22,1,.36,1),box-shadow .24s ease}
.explore-camera:active{transform:scale(.94);box-shadow:var(--shadow-md)}
.explore-camera .camera-icon{position:relative;width:36rpx;height:28rpx;border:2.5rpx solid var(--paper);border-radius:4rpx}
.explore-camera .camera-icon::before{content:'';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:14rpx;height:14rpx;border:2.5rpx solid var(--paper);border-radius:50%}
.explore-camera .camera-icon::after{content:'';position:absolute;right:4rpx;top:-7rpx;width:10rpx;height:4rpx;background:var(--paper);border-radius:2rpx}
.reduce-motion .explore-camera{transition:none}

.world-canvas{position:relative;min-height:54vh;display:flex;flex-direction:column;margin:0 -8rpx 28rpx;padding:28rpx 20rpx 24rpx;background:#EBEDE2;border-radius:var(--radius-card);overflow:hidden}
.world-heading{position:relative;z-index:1;text-align:center}
.world-heading .eyebrow{display:block;font-size:22rpx;color:var(--muted);letter-spacing:.08em;margin-bottom:8rpx}
.world-heading .title{margin:6rpx 0 10rpx;font-size:44rpx}
.world-heading>.sub{display:block;max-width:34ch;margin:0 auto;font-size:24rpx}
.world-ecosystem{position:relative;flex:1;min-height:540rpx;margin:20rpx -8rpx 0}
.world-caption{position:relative;font-size:22rpx;color:#586459;margin-top:auto;overflow-wrap:anywhere;text-align:center;display:block}

/* ===== 手绘分层场景装饰（§32：可复用元素拼合）===== */
.deco{position:absolute;pointer-events:none;will-change:opacity}
.deco-sun{width:150rpx;left:7%;top:5%;opacity:.9;transition:opacity .32s ease}
.deco-cloud{width:230rpx;right:3%;top:7%;opacity:.92;transition:opacity .32s ease}
.deco-hills{width:112%;left:-6%;bottom:24%;opacity:.92}
.deco-tree{width:260rpx;left:1%;bottom:10%;opacity:0;transition:opacity .32s ease}
.deco-grass{width:104%;left:-2%;bottom:-6rpx;opacity:.96}
.deco-rocks{width:104rpx;right:6%;bottom:3%}
.deco-reeds{width:64rpx;right:19%;bottom:1%}
.deco-mushroom{width:52rpx;left:33%;bottom:5%}
/* 季节决定哪棵树在场 */
.season-spring .tree-lush,.season-summer .tree-lush{opacity:1}
.season-autumn .tree-autumn{opacity:1}
.season-winter .tree-winter{opacity:1}
/* 时间氛围 */
.phase-dusk .deco-sun{opacity:.5}
.phase-night .deco-sun{opacity:0}
.phase-night .deco-cloud{opacity:.3}
.phase-night .deco{filter:brightness(.94) saturate(.9)}

/* 场景底层 */
.scene-ground{position:absolute;bottom:1%;left:-12%;height:24%;width:125%;border-top:1rpx solid #BBC6AF;border-radius:50% 50% 0 0;background:#E1E5D5}
.scene-water{position:absolute;bottom:2%;right:6%;width:30%;height:13%;border:1rpx solid #BECDD0;border-radius:50%;background:#DBE5E4}
.scene-sky{position:absolute;top:0;left:0;right:0;height:46%;background:var(--season-sky);--season-sky:#E9EDE6;border-radius:24rpx 24rpx 0 0;transition:background .32s ease}

/* 季节色彩变量 */
.world-canvas{--season-canvas:#EBEDE2;--season-canopy:#E0E6D8;--season-canopy-line:#C3CCB9;--season-ground:#E1E5D5;--season-ground-line:#BBC6AF;--season-water:#DBE5E4;--season-water-line:#BECDD0;--season-branch:#B6BEAC;--season-sky:#E9EDE6;--season-accent:#E7A9B8;--season-accent2:#D98E4A;transition:background .32s ease}
.season-summer{--season-canvas:#E4EAD9;--season-canopy:#C9D8AE;--season-canopy-line:#9FB584;--season-ground:#D5E0BE;--season-ground-line:#9FB584;--season-water:#C8DCD6;--season-water-line:#A8C2BD;--season-branch:#8FA67A;--season-sky:#E6EDE2;--season-accent:#E7A9B8;--season-accent2:#D98E4A}
.season-autumn{--season-canvas:#F0E4CE;--season-canopy:#E7C98E;--season-canopy-line:#C8A15A;--season-ground:#E9D9B8;--season-ground-line:#C8A15A;--season-water:#D8DED4;--season-water-line:#B4BEAE;--season-branch:#B08A4E;--season-sky:#F0E9D8;--season-accent:#C77B3B;--season-accent2:#8E5A2B}
.season-winter{--season-canvas:#E3E8E6;--season-canopy:#D4DCD7;--season-canopy-line:#A9B8B2;--season-ground:#E8ECE9;--season-ground-line:#BCC7C1;--season-water:#D3DFDE;--season-water-line:#AFC0BD;--season-branch:#9AA9A2;--season-sky:#E5EBEA;--season-accent:#AFC6D8;--season-accent2:#7E9CB0}
.season-layer{position:absolute;inset:0;pointer-events:none;z-index:0;background-repeat:no-repeat;transition:opacity .32s ease;opacity:1}
.season-autumn .season-layer{background-image:radial-gradient(6rpx 9rpx at 18% 74%,#C77B3B 55%,transparent 56%),radial-gradient(6rpx 9rpx at 34% 82%,#D98E4A 55%,transparent 56%),radial-gradient(6rpx 9rpx at 62% 76%,#C77B3B 55%,transparent 56%),radial-gradient(5rpx 8rpx at 81% 70%,#B06A32 55%,transparent 56%),radial-gradient(6rpx 9rpx at 46% 66%,#E7A258 55%,transparent 56%)}
.season-spring .season-layer{background-image:radial-gradient(7rpx 7rpx at 24% 30%,#F2C7D4 55%,transparent 56%),radial-gradient(7rpx 7rpx at 48% 24%,#F2C7D4 55%,transparent 56%),radial-gradient(6rpx 6rpx at 68% 34%,#F6D8B8 55%,transparent 56%),radial-gradient(7rpx 7rpx at 38% 38%,#F6D8B8 55%,transparent 56%),radial-gradient(6rpx 6rpx at 82% 26%,#F2C7D4 55%,transparent 56%)}
.season-winter .season-layer{background-image:radial-gradient(5rpx 5rpx at 20% 22%,#FFFFFF 60%,transparent 61%),radial-gradient(5rpx 5rpx at 55% 16%,#FFFFFF 60%,transparent 61%),radial-gradient(4rpx 4rpx at 78% 28%,#FFFFFF 60%,transparent 61%),radial-gradient(5rpx 5rpx at 40% 34%,#FFFFFF 60%,transparent 61%),radial-gradient(4rpx 4rpx at 12% 38%,#FFFFFF 60%,transparent 61%),radial-gradient(5rpx 5rpx at 68% 40%,#FFFFFF 60%,transparent 61%)}
.season-summer .season-layer{background-image:radial-gradient(8rpx 8rpx at 12% 16%,#F2CF70 60%,transparent 61%),radial-gradient(6rpx 6rpx at 74% 42%,#F2CF70 60%,transparent 61%),radial-gradient(5rpx 5rpx at 30% 48%,#8FA67A 60%,transparent 61%),radial-gradient(5rpx 5rpx at 56% 52%,#8FA67A 60%,transparent 61%)}
.atmosphere-layer{position:absolute;inset:0;pointer-events:none;z-index:0;transition:opacity .32s ease;opacity:0}
.phase-dusk .atmosphere-layer{opacity:1;background:linear-gradient(160deg,rgba(242,183,108,.34),rgba(184,73,42,.18) 55%,rgba(36,48,40,.14))}
.phase-night .atmosphere-layer{opacity:1;background:linear-gradient(180deg,rgba(24,44,60,.42),rgba(24,44,60,.30))}
.phase-night .world-specimen{filter:brightness(.9)}
.reduce-motion .world-canvas,.reduce-motion .season-layer,.reduce-motion .atmosphere-layer,.reduce-motion .scene-sky,.reduce-motion .scene-ground,.reduce-motion .scene-water,.reduce-motion .deco,.reduce-motion .deco-tree{transition:none}

/* 世界中的物种标本 */
.world-specimen{position:absolute;width:23%;height:37%;min-width:0;z-index:2;transition:transform .24s cubic-bezier(.22,1,.36,1)}
.world-specimen:active{transform:scale(1.06)}
.world-specimen .scene-image{mix-blend-mode:multiply}
.zone-canopy{left:7%;top:4%}.zone-canopy.slot-1{left:32%;top:9%}
.zone-branch{left:51%;top:29%}.zone-branch.slot-1{left:75%;top:24%}
.zone-ground{left:6%;bottom:0}.zone-ground.slot-1{left:31%;bottom:0}
.zone-water{right:15%;bottom:0}.zone-water.slot-1{right:0;bottom:18%}
.world-empty-copy{position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;font-size:28rpx;padding:24rpx;text-align:center}
.world-empty-copy>.sub{max-width:25ch}

/* 底部统计入口卡 */
.explore-bottom{margin-bottom:28rpx}
.explore-stat-card{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:28rpx 28rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-card);box-shadow:var(--shadow-sm);transition:transform .24s cubic-bezier(.22,1,.36,1),box-shadow .24s ease}
.explore-stat-card:active{transform:scale(.985);box-shadow:var(--shadow-md)}
.stat-copy{display:flex;flex-direction:column;gap:6rpx}
.stat-eyebrow{font-size:22rpx;color:var(--muted);letter-spacing:.06em}
.stat-count{font-family:var(--font-heading);font-size:34rpx;color:var(--ink);font-weight:600}
.stat-action{font-size:24rpx;color:var(--color-primary);flex:none}
.reduce-motion .explore-stat-card{transition:none}

/* 最近相遇细横条 */
.recent-strip{margin-top:40rpx}
.recent-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}
.recent-scroll{white-space:nowrap;width:100%}
.recent-specimen{display:inline-block;vertical-align:top;width:220rpx;height:320rpx;margin-right:16rpx;white-space:normal}
.recent-specimen:last-child{margin-right:0}
.recent-specimen collectible{display:block;width:100%;height:100%}

/* 世界物种信息弹层 */
.world-sheet-mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;justify-content:center;background:rgba(24,48,40,.34);padding:24rpx}
.world-sheet{width:100%;max-width:640rpx;padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-card);box-shadow:var(--shadow-lg)}
.world-sheet .sheet-head{display:flex;flex-direction:column;gap:8rpx}
.world-sheet .sheet-head .section{font-size:36rpx}
.world-sheet .latin-row{font-style:italic;overflow-wrap:anywhere}
.world-sheet .sheet-stats{display:flex;gap:16rpx;margin-top:24rpx}
.world-sheet .sheet-stat{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx;padding:20rpx 16rpx;background:var(--color-surface-2);border:1rpx solid var(--color-border);border-radius:20rpx}
.world-sheet .stat-value{font-size:32rpx;color:var(--color-text)}
.world-sheet .stat-value.sheet-date{font-size:24rpx;line-height:1.4;overflow-wrap:anywhere}
.world-sheet button{margin-top:20rpx}

.return-top{position:fixed;right:24rpx;bottom:calc(156rpx + env(safe-area-inset-bottom));z-index:19;min-height:88rpx;padding:20rpx 24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:22rpx;color:var(--ink);font-size:24rpx}

@media(max-width:390px){.world-heading .title{font-size:40rpx}.world-ecosystem{min-height:480rpx}.explore-brand .brand{font-size:34rpx}.deco-tree{width:220rpx}.deco-cloud{width:200rpx}}
@media(max-width:320px){.world-canvas{padding:24rpx 16rpx}.world-ecosystem{min-height:460rpx}.world-heading .title{font-size:38rpx}.world-specimen{width:25%;height:35%}.explore-hero{gap:16rpx}.explore-brand .brand-tag{font-size:22rpx}.deco-tree{width:190rpx}.deco-sun{width:120rpx}.deco-cloud{width:170rpx}.deco-mushroom{width:44rpx}.deco-rocks{width:88rpx}.recent-specimen{width:200rpx;height:290rpx}}
