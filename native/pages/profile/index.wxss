/* 徽章等级标签与收集引导：未获得的保留轮廓与进度，让下一步看得见 */
.species-badge-tier{display:inline-block;margin-left:8rpx;padding:2rpx 10rpx;border-radius:999rpx;font-size:22rpx;font-weight:500;color:var(--color-text-secondary);background:var(--color-surface-3);border:1rpx solid var(--color-border);vertical-align:middle}
.tier-silver .species-badge-tier{color:#5A6B78;background:#EDF2F6;border-color:#CFDCE4}
.tier-gold .species-badge-tier{color:#7A5F1B;background:#FAF1D9;border-color:#E8D49A}
.tier-platinum .species-badge-tier{color:#4A5A5E;background:#EEF2F3;border-color:#CCD7DB}
.species-badge-image{position:relative}
.species-badge:not(.earned) .species-badge-state{color:var(--color-text-tertiary)}
.badge-heading .track{margin:12rpx 0 0;height:12rpx}
.badge-heading .fill{background:var(--color-accent)}
