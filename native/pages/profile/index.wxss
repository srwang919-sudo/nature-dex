));background:var(--surface)}.badge-medal{width:88rpx;height:88rpx;border-radius:50%;position:relative;outline:4rpx solid #EDE8D8;outline-offset:3rpx;margin-bottom:16rpx;background:#F0EBDD}.badge-medal.on{background:#F2CF70;border-color:#9A7935;outline-color:#F5E4AE}.badge-name{font-size:26rpx}.badge-condition{max-width:240rpx;line-height:1.5}.subscription-card{background:none;border:0;border-radius:0;padding:16rpx 0}.notes-heading{margin-top:28rpx}
.species-badge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22rpx 12rpx;margin:24rpx 0}.species-badge-section{margin:32rpx 0}.species-badge-strip{display:flex;gap:18rpx;padding:20rpx 0}.species-badge-strip .species-badge{flex:0 0 160rpx}.species-badge{min-width:0;text-align:center;display:flex;flex-direction:column;align-items:center}.species-badge-image{width:112rpx;height:112rpx;max-width:100%}.species-badge-name{font-size:24rpx;line-height:1.5;word-break:break-all}/* 进度文本是「还差多少能拿到」的关键信息，不能弱到读不清：24rpx + 达标对比度 */
.species-badge-state{font-size:24rpx;color:var(--color-text-secondary);margin-top:4rpx}.badge-placeholder{width:112rpx;height:112rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:22rpx;color:var(--color-text-secondary)}.badge-leaf{width:36rpx;height:52rpx;border:2rpx solid var(--color-text-secondary);border-radius:0 70% 0 70%;transform:rotate(30deg);margin-bottom:16rpx}
