.museum-identity{display:flex;align-items:center;gap:24rpx;margin:32rpx 0}.museum-avatar{width:104rpx;height:104rpx;flex:none;border:2rpx solid var(--moss);border-radius:50%;background:#E7EBDE;display:flex;align-items:center;justify-content:center;font-size:40rpx;color:var(--moss)}.museum-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;margin:28rpx 0}.museum-stats>view{display:flex;flex-direction:column;gap:12rpx;font-size:30rpx;min-width:0}.museum-stats .sub{font-size:24rpx}.museum-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;margin-top:24rpx}.museum-card{padding:22rpx;border:1rpx solid var(--line);border-radius:18rpx;min-width:0;background:var(--surface);overflow-wrap:anywhere}.museum-card .section{font-size:30rpx}.museum-card>.sub,.museum-latin{display:block;margin:12rpx 0}.museum-latin{font-family:Georgia,serif;font-style:italic;font-size:24rpx}.museum-card button{font-size:24rpx;margin-top:16rpx;padding:14rpx;min-height:88rpx}.museum-recent{border-bottom:1rpx solid var(--line);padding:22rpx 0;font-size:28rpx}@media(max-width:340px){.museum-grid{grid-template-columns:1fr}.museum-stats{gap:10rpx}.museum-stats>view{font-size:26rpx}}
