/* 旅程 = 一张地图：手绘底图 + 轨迹曲线 + 图钉节点 */
.journey-page>.title{margin-top:8rpx}
.journey-empty{padding:72rpx 0;max-width:620rpx}
.journey-empty>.sub{display:block;margin-top:24rpx}

/* ---- 罗盘概览 ---- */
.journey-compass{display:flex;justify-content:space-around;gap:16rpx;margin-top:32rpx;padding:24rpx 16rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm)}
.compass-cell{display:flex;flex-direction:column;align-items:center;gap:6rpx;font-size:22rpx;color:var(--color-text-secondary);min-width:0}
.compass-cell .number{font-size:40rpx;color:var(--color-text);line-height:1.1}

/* ---- 地图 ---- */
.journey-map{position:relative;height:640rpx;margin-top:28rpx;border-radius:var(--radius-xl);overflow:hidden;border:1rpx solid var(--color-border);box-shadow:var(--shadow-md);background:#EFEFE6}
.map-base{position:absolute;inset:0;width:100%;height:100%}
.map-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:1}
.map-node{position:absolute;z-index:2;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx}
.node-pin{width:26rpx;height:26rpx;border-radius:50%;background:var(--color-primary);border:4rpx solid #FFFFFF;box-shadow:0 2rpx 8rpx rgba(44,62,53,.4)}
.map-node.is-latest .node-pin{background:var(--color-accent)}
.map-node.is-latest .node-pin::after{content:'';position:absolute;left:50%;top:13rpx;width:26rpx;height:26rpx;margin-left:-13rpx;border-radius:50%;border:2rpx solid var(--color-accent);animation:pin-pulse 2.2s ease-out infinite}
.node-tag{margin-top:8rpx;padding:3rpx 12rpx;border-radius:999rpx;background:rgba(255,255,255,.92);border:1rpx solid var(--color-border);font-size:18rpx;line-height:1.4;color:var(--color-text);white-space:nowrap}
@keyframes pin-pulse{0%{opacity:.85;transform:scale(.7)}70%{opacity:0;transform:scale(1.9)}100%{opacity:0;transform:scale(1.9)}}
.reduce-motion .node-pin::after{animation:none;opacity:0}
/* 地图角落：指北针与比例尺 */
.map-compass{position:absolute;right:20rpx;top:20rpx;z-index:3;width:56rpx;height:56rpx;border-radius:50%;background:rgba(255,255,255,.82);border:1rpx solid var(--color-border);display:flex;align-items:center;justify-content:center}
.map-compass::before{content:'';width:0;height:0;border-left:9rpx solid transparent;border-right:9rpx solid transparent;border-bottom:20rpx solid var(--color-danger)}
.map-compass::after{content:'';position:absolute;bottom:12rpx;width:0;height:0;border-left:9rpx solid transparent;border-right:9rpx solid transparent;border-top:20rpx solid var(--color-text-secondary);opacity:.5}
.map-scale{position:absolute;left:20rpx;bottom:18rpx;z-index:3;display:flex;align-items:center;gap:8rpx;font-size:18rpx;color:var(--color-text-secondary)}
.map-scale-rule{width:64rpx;height:8rpx;border:1rpx solid var(--color-text-secondary);border-top:0}

/* ---- 图例 ---- */
.map-legend{display:flex;flex-wrap:wrap;gap:20rpx;margin-top:20rpx;font-size:22rpx;color:var(--color-text-secondary)}
.legend-item{display:flex;align-items:center;gap:8rpx}
.legend-dot{width:16rpx;height:16rpx;border-radius:50%;background:var(--color-primary);border:2rpx solid #fff}
.legend-dot.current{background:var(--color-accent)}
.legend-dot.landmark{border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--color-accent)}

/* ---- 轨迹明细 ---- */
.track-list{margin-top:8rpx}
.track-row{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:1rpx solid var(--color-border);font-size:26rpx}
.track-row:first-child{border-top:0}
.track-date{flex:none;width:130rpx;color:var(--color-text-secondary);font-size:24rpx}
.track-name{flex:1;min-width:0;overflow-wrap:anywhere}

/* ---- 地标 ---- */
.landmark-panel{margin-top:32rpx;padding:24rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg)}
.landmark-panel>.sub{display:block;margin-top:8rpx}
.landmark{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:1rpx solid var(--color-border);font-size:26rpx;overflow-wrap:anywhere}
.landmark:first-of-type{border-top:0;margin-top:12rpx}
.landmark-marker{width:32rpx;height:32rpx;flex:none;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--color-accent);border:2rpx solid var(--color-surface-1);box-shadow:var(--shadow-sm)}
.landmark-count{margin-left:auto;flex:none;color:var(--color-text-secondary);font-size:24rpx}

@media(max-width:340px){.journey-map{height:560rpx}.node-tag{font-size:17rpx}}
