.journey-page>.title{margin-top:8rpx}.journey-empty{padding:72rpx 0;max-width:620rpx}.journey-empty>.sub{display:block;margin-top:24rpx}.species-journey{margin-top:40rpx;padding-bottom:24rpx;border-bottom:1rpx solid var(--line)}.journey-heading{display:flex;gap:28rpx;align-items:center}.journey-portrait{width:152rpx;height:180rpx;flex:none}.journey-heading-copy{min-width:0;flex:1;overflow-wrap:anywhere}.observation-thread{padding-left:24rpx;margin:20rpx 0 0 56rpx;border-left:1rpx solid var(--line)}.observation-entry{position:relative;display:flex;align-items:center;gap:20rpx;background:none;text-align:left;min-height:96rpx;padding:18rpx 0;font-size:28rpx;line-height:1.5;color:var(--ink)}.thread-dot{position:absolute;left:-31rpx;width:12rpx;height:12rpx;border:2rpx solid var(--moss);background:var(--paper);border-radius:50%}.thread-link{margin-left:auto;flex:none;color:var(--moss);font-size:24rpx}.place-row{display:flex;justify-content:space-between;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}
