.explore-top{display:flex;justify-content:space-between;align-items:center;gap:24rpx}.brand{font-size:30rpx;font-weight:600}.eyebrow{font-size:24rpx;color:var(--muted);letter-spacing:.06em}
.record-area{display:flex;align-items:center;justify-content:center;margin:24rpx 0 0}.record-hint{display:block;text-align:center;margin-top:12rpx}.home-record{flex:1;font-size:30rpx}
.return-top{position:fixed;right:24rpx;bottom:calc(156rpx + env(safe-area-inset-bottom));z-index:19;min-height:88rpx;padding:20rpx 24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:22rpx;color:var(--ink);font-size:24rpx}
.reduce-motion .home-record{transition:none;transform:none}
.world-canvas{position:relative;min-height:48vh;display:flex;flex-direction:column;margin:24rpx -8rpx 32rpx;padding:28rpx 20rpx 20rpx;background:#EBEDE2;border-radius:28rpx;overflow:hidden}.world-heading{position:relative;z-index:1}.world-heading .title{margin:12rpx 0;font-size:44rpx}.world-heading>.sub{display:block;max-width:30ch}.world-caption{position:relative;font-size:22rpx;color:#586459;margin-top:auto;overflow-wrap:anywhere}.world-ecosystem{position:relative;flex:1;min-height:470rpx;margin:12rpx -8rpx 16rpx}.scene-ground{position:absolute;bottom:1%;left:-12%;height:24%;width:125%;border-top:1rpx solid #BBC6AF;border-radius:50% 50% 0 0;background:#E1E5D5}.scene-water{position:absolute;bottom:2%;right:6%;width:30%;height:13%;border:1rpx solid #BECDD0;border-radius:50%;background:#DBE5E4}.world-specimen{position:absolute;width:23%;height:37%;min-width:0;z-index:2}.zone-canopy{left:7%;top:4%}.zone-canopy.slot-1{left:32%;top:9%}.zone-branch{left:51%;top:29%}.zone-branch.slot-1{left:75%;top:24%}.zone-ground{left:6%;bottom:0}.zone-ground.slot-1{left:31%;bottom:0}.zone-water{right:15%;bottom:0}.zone-water.slot-1{right:0;bottom:18%}.world-empty-copy{position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;font-size:28rpx;padding:24rpx;text-align:center}.world-empty-copy>.sub{max-width:25ch}
/* ===== 手绘分层场景装饰（§32：可复用元素拼合，非整张 AI 场景）===== */
/* 全部图片装饰都是纯氛围层：不响应点击，加载失败整层退回 CSS 场景。 */
.deco{position:absolute;pointer-events:none;will-change:opacity}
.deco-sun{width:150rpx;left:7%;top:5%;opacity:.9;transition:opacity .8s ease}
.deco-cloud{width:230rpx;right:3%;top:7%;opacity:.92;transition:opacity .8s ease}
.deco-hills{width:112%;left:-6%;bottom:24%;opacity:.92}
.deco-tree{width:200rpx;left:8%;bottom:13%;opacity:0;transition:opacity .7s ease}
.deco-grass{width:104%;left:-2%;bottom:-6rpx;opacity:.96}
.deco-rocks{width:104rpx;right:6%;bottom:3%}
.deco-reeds{width:64rpx;right:19%;bottom:1%}
.deco-mushroom{width:52rpx;left:33%;bottom:5%}
/* 季节决定哪棵树在场：春/夏茂绿、秋金、冬枯枝（§40） */
.season-spring .tree-lush,.season-summer .tree-lush{opacity:1}
.season-autumn .tree-autumn{opacity:1}
.season-winter .tree-winter{opacity:1}
/* 时间氛围（§41）：黄昏日头低垂，夜晚日隐云淡 */
.phase-dusk .deco-sun{opacity:.5}
.phase-night .deco-sun{opacity:0}
.phase-night .deco-cloud{opacity:.3}
.phase-night .deco{filter:brightness(.94) saturate(.9)}
@media(max-width:390px){.world-heading .title{font-size:40rpx}.world-ecosystem{min-height:450rpx}.world-caption{font-size:24rpx;line-height:1.5}.deco-tree{width:180rpx}.deco-cloud{width:200rpx}}
@media(max-width:320px){.world-canvas{padding:24rpx 16rpx}.world-ecosystem{min-height:490rpx}.world-heading .title{font-size:38rpx}.world-specimen{width:25%;height:35%}.record-area{gap:16rpx}.album-entry{font-size:28rpx}.deco-tree{width:165rpx}.deco-sun{width:120rpx}.deco-cloud{width:170rpx}.deco-mushroom{width:44rpx}.deco-rocks{width:88rpx}}
/* ===== 自然世界四季氛围（§40–41）===== */
/* 场景层默认颜色由季节变量驱动；base 为春（柔和）默认值 */
.world-canvas{--season-canvas:#EBEDE2;--season-canopy:#E0E6D8;--season-canopy-line:#C3CCB9;--season-ground:#E1E5D5;--season-ground-line:#BBC6AF;--season-water:#DBE5E4;--season-water-line:#BECDD0;--season-branch:#B6BEAC;--season-sky:#E9EDE6;--season-accent:#E7A9B8;--season-accent2:#D98E4A;transition:background .6s ease}
.world-canvas .scene-sky{position:absolute;top:0;left:0;right:0;height:46%;background:var(--season-sky);border-radius:24rpx 24rpx 0 0;transition:background .6s ease}
.world-canvas .scene-ground{background:var(--season-ground);border-color:var(--season-ground-line);transition:background .6s ease,border-color .6s ease}
.world-canvas .scene-ground{background:var(--season-ground);border-color:var(--season-ground-line);transition:background .6s ease,border-color .6s ease}
.world-canvas .scene-water{background:var(--season-water);border-color:var(--season-water-line);transition:background .6s ease,border-color .6s ease}
/* 树冠色相随季节微调地面与水面的色线（树本体由手绘图层表现） */
.world-canvas{background:var(--season-canvas)}
/* 季节细节层：由 background-image 叠加绘制，不同季节切换 */
.season-layer{position:absolute;inset:0;pointer-events:none;z-index:0;background-repeat:no-repeat;transition:opacity .6s ease;opacity:1}
/* 夏：浓绿 + 昆虫氛围（深一点绿 + 暖阳点缀） */
.world-canvas.season-summer{--season-canvas:#E4EAD9;--season-canopy:#C9D8AE;--season-canopy-line:#9FB584;--season-ground:#D5E0BE;--season-ground-line:#9FB584;--season-water:#C8DCD6;--season-water-line:#A8C2BD;--season-branch:#8FA67A;--season-sky:#E6EDE2;--season-accent:#E7A9B8;--season-accent2:#D98E4A}
/* 秋：黄叶 + 落叶 + 迁徙鸟 */
.world-canvas.season-autumn{--season-canvas:#F0E4CE;--season-canopy:#E7C98E;--season-canopy-line:#C8A15A;--season-ground:#E9D9B8;--season-ground-line:#C8A15A;--season-water:#D8DED4;--season-water-line:#B4BEAE;--season-branch:#B08A4E;--season-sky:#F0E9D8;--season-accent:#C77B3B;--season-accent2:#8E5A2B}
/* 冬：枝干 + 冷色空气感 */
.world-canvas.season-winter{--season-canvas:#E3E8E6;--season-canopy:#D4DCD7;--season-canopy-line:#A9B8B2;--season-ground:#E8ECE9;--season-ground-line:#BCC7C1;--season-water:#D3DFDE;--season-water-line:#AFC0BD;--season-branch:#9AA9A2;--season-sky:#E5EBEA;--season-accent:#AFC6D8;--season-accent2:#7E9CB0}
/* 秋：落叶点缀（小色块模拟飘落叶片） */
.world-canvas.season-autumn .season-layer{background-image:radial-gradient(6rpx 9rpx at 18% 74%,#C77B3B 55%,transparent 56%),radial-gradient(6rpx 9rpx at 34% 82%,#D98E4A 55%,transparent 56%),radial-gradient(6rpx 9rpx at 62% 76%,#C77B3B 55%,transparent 56%),radial-gradient(5rpx 8rpx at 81% 70%,#B06A32 55%,transparent 56%),radial-gradient(6rpx 9rpx at 46% 66%,#E7A258 55%,transparent 56%)}
/* 春：花点缀 */
.world-canvas.season-spring .season-layer{background-image:radial-gradient(7rpx 7rpx at 24% 30%,#F2C7D4 55%,transparent 56%),radial-gradient(7rpx 7rpx at 48% 24%,#F2C7D4 55%,transparent 56%),radial-gradient(6rpx 6rpx at 68% 34%,#F6D8B8 55%,transparent 56%),radial-gradient(7rpx 7rpx at 38% 38%,#F6D8B8 55%,transparent 56%),radial-gradient(6rpx 6rpx at 82% 26%,#F2C7D4 55%,transparent 56%)}
/* 冬：雪点 */
.world-canvas.season-winter .season-layer{background-image:radial-gradient(5rpx 5rpx at 20% 22%,#FFFFFF 60%,transparent 61%),radial-gradient(5rpx 5rpx at 55% 16%,#FFFFFF 60%,transparent 61%),radial-gradient(4rpx 4rpx at 78% 28%,#FFFFFF 60%,transparent 61%),radial-gradient(5rpx 5rpx at 40% 34%,#FFFFFF 60%,transparent 61%),radial-gradient(4rpx 4rpx at 12% 38%,#FFFFFF 60%,transparent 61%),radial-gradient(5rpx 5rpx at 68% 40%,#FFFFFF 60%,transparent 61%)}
/* 夏：暖阳 + 昆虫点（小亮绿/金黄） */
.world-canvas.season-summer .season-layer{background-image:radial-gradient(8rpx 8rpx at 12% 16%,#F2CF70 60%,transparent 61%),radial-gradient(6rpx 6rpx at 74% 42%,#F2CF70 60%,transparent 61%),radial-gradient(5rpx 5rpx at 30% 48%,#8FA67A 60%,transparent 61%),radial-gradient(5rpx 5rpx at 56% 52%,#8FA67A 60%,transparent 61%)}
/* 时间氛围叠层（§41）：黄昏暖橙 / 夜晚冷蓝，叠加在场景之上、物种之下 */
.atmosphere-layer{position:absolute;inset:0;pointer-events:none;z-index:0;transition:opacity .8s ease;opacity:0}
.world-canvas.phase-dusk .atmosphere-layer{opacity:1;background:linear-gradient(160deg,rgba(242,183,108,.34),rgba(184,73,42,.18) 55%,rgba(36,48,40,.14))}
.world-canvas.phase-night .atmosphere-layer{opacity:1;background:linear-gradient(180deg,rgba(24,44,60,.42),rgba(24,44,60,.30))}
/* 夜晚把物种卡也轻微压暗，保持可读但不刺眼 */
.world-canvas.phase-night .world-specimen{filter:brightness(.9)}
/* reduce-motion：关闭过渡动效 */
.reduce-motion .world-canvas,.reduce-motion .season-layer,.reduce-motion .atmosphere-layer,.reduce-motion .scene-sky,.reduce-motion .scene-ground,.reduce-motion .scene-water,.reduce-motion .deco,.reduce-motion .deco-tree{transition:none}
/* ===== 自然世界物种信息弹层（§10 点击信息层）===== */
.world-sheet-mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;justify-content:center;background:rgba(24,48,40,.34);padding:24rpx}
.world-sheet{width:100%;max-width:640rpx;padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:28rpx;box-shadow:var(--shadow-lg)}
.world-sheet .sheet-head{display:flex;flex-direction:column;gap:8rpx}
.world-sheet .sheet-head .section{font-size:36rpx}
.world-sheet .latin-row{font-style:italic;overflow-wrap:anywhere}
.world-sheet .sheet-stats{display:flex;gap:16rpx;margin-top:24rpx}
.world-sheet .sheet-stat{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx;padding:20rpx 16rpx;background:var(--color-surface-2);border:1rpx solid var(--color-border);border-radius:20rpx}
.world-sheet .stat-value{font-size:32rpx;color:var(--color-text)}
.world-sheet .stat-value.sheet-date{font-size:24rpx;line-height:1.4;overflow-wrap:anywhere}
.world-sheet button{margin-top:20rpx}
