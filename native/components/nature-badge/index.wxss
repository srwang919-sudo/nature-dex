.enamel{width:100%;height:100%;padding:8%;box-sizing:border-box;background:#C99B48;border-radius:50%;box-shadow:inset 0 0 0 1px #AE8443}.rim{position:relative;width:100%;height:100%;border:1px solid #E8C886;box-sizing:border-box;border-radius:50%;background:#49634E}.motif{position:absolute;inset:14%;color:#FFF5D7}.part{position:absolute;box-sizing:border-box}.locked{filter:grayscale(1);background:#B9BEB6}.locked .rim{background:#606C60;border-color:#DDE1D7}.earned{box-shadow:inset 0 0 0 2px #936D29,inset 0 3px 0 3px #FFE3A2}.earned .rim{border-width:2px;border-color:#F5DE9E}.large{box-shadow:inset 0 0 0 2px #AE8443}
.motif-first .a{inset:22%;border:2px solid currentColor;border-radius:50%}.motif-first .b{left:48%;top:0;width:4%;height:100%;background:currentColor}.motif-first .c{left:0;top:48%;width:100%;height:4%;background:currentColor}.motif-first .d{inset:32%;border-radius:50%;background:#C99B48}
.motif-plants .a,.motif-plants .b,.motif-plants .c{width:36%;height:58%;border:2px solid currentColor;border-radius:90% 0 90% 0;left:33%;top:5%;transform:rotate(-40deg)}.motif-plants .b{left:5%;top:32%;transform:rotate(-80deg)}.motif-plants .c{left:59%;top:32%;transform:rotate(5deg)}
.motif-birds .a,.motif-birds .b{width:58%;height:44%;border-top:3px solid currentColor;border-radius:60%;top:30%;transform:rotate(22deg)}.motif-birds .b{right:0;transform:rotate(-22deg)}.motif-birds .c{width:5%;height:26%;background:currentColor;left:48%;top:35%}
.motif-insects .a{width:25%;height:64%;left:38%;top:18%;border:2px solid currentColor;border-radius:50%}.motif-insects .b,.motif-insects .c{width:36%;height:58%;border:2px solid currentColor;border-radius:50%;left:4%;top:17%}.motif-insects .c{left:62%}.motif-insects .d{width:42%;height:2px;left:29%;top:8%;background:currentColor}
.motif-repeat .a,.motif-repeat .b{width:66%;height:66%;border:3px solid currentColor;border-radius:50%;left:0;top:17%}.motif-repeat .b{left:34%}
.motif-notes .a{inset:8% 20%;border:2px solid currentColor;border-radius:5%}.motif-notes .b,.motif-notes .c,.motif-notes .d{left:32%;width:36%;height:2px;background:currentColor;top:32%}.motif-notes .c{top:50%}.motif-notes .d{top:68%}
.motif-dates .a{inset:8%;border:2px solid currentColor;border-radius:50%}.motif-dates .b{top:10%;bottom:10%;left:49%;width:2px;background:currentColor}.motif-dates .c{left:10%;right:10%;top:49%;height:2px;background:currentColor}.motif-dates .d{inset:22% 52% 52% 22%;border-radius:50%;background:#C99B48}
.motif-places .a,.motif-places .b{width:55%;height:55%;border-top:2px solid currentColor;border-left:2px solid currentColor;transform:rotate(45deg);top:36%;left:9%}.motif-places .b{width:36%;height:36%;left:52%;top:51%}.motif-places .c{width:16%;height:16%;border-radius:50%;background:#C99B48;top:8%;right:15%}
.motif-ten .a,.motif-ten .b{top:19%;height:66%;width:40%;border:2px solid currentColor;border-radius:8% 8% 0 0;left:10%}.motif-ten .b{left:50%}.motif-ten .c{height:2px;width:23%;left:18%;top:36%;background:currentColor}
.motif-twenty .a{inset:5%;border:2px solid currentColor;border-radius:50%}.motif-twenty .b{inset:25%;border:2px solid currentColor;border-radius:50%}.motif-twenty .c{inset:42%;background:#C99B48;transform:rotate(45deg)}.motif-twenty .d{left:45%;top:0;width:10%;height:10%;background:currentColor;border-radius:50%}
.motif-puzzle .part{width:36%;height:36%;border:2px solid currentColor;left:9%;top:9%;border-radius:10%}.motif-puzzle .b{left:55%}.motif-puzzle .c{top:55%}.motif-puzzle .d{left:55%;top:55%;background:#C99B48}
.motif-read .a{inset:24% 4%;border:2px solid currentColor;border-radius:70% 5%;transform:rotate(45deg)}.motif-read .b{inset:35%;border:2px solid currentColor;border-radius:50%}.motif-read .c{inset:45%;border-radius:50%;background:#C99B48}
