<view class="page library-page {{reduceMotion?'reduce-motion':''}}">
 <view wx:if="{{syncing}}" class="sub" role="status">正在恢复我的云端卡片…</view><view wx:if="{{syncError}}" class="notice">{{syncError}}<button bindtap="sync">重试同步</button></view>
 <view wx:if="{{syncNeedsConsent}}" class="sub">云端卡片恢复未开启，本地收藏不受影响。<button class="secondary" bindtap="recoverySettings">前往隐私设置</button></view>
 <view class="library-heading"><text class="eyebrow">我的自然观察手册</text><view class="title">我的图鉴</view><text class="sub">{{speciesCount}} 种相遇 · {{ownedCount}} 次记录</text></view>
 <view class="layout-switch" aria-label="收藏布局"><button class="layout-button {{layout==='neat'?'selected':''}}" data-layout="neat" bindtap="setCollectionLayout" aria-label="{{layout==='neat'?'整齐，已选':'整齐'}}">整齐</button><button class="layout-button {{layout==='shelf'?'selected':''}}" data-layout="shelf" bindtap="setCollectionLayout" aria-label="{{layout==='shelf'?'卡架，已选':'卡架'}}">卡架</button></view>
 <block wx:if="{{cards.length}}"><view wx:if="{{layout==='neat'}}" class="card-grid"><view wx:for="{{cards}}" wx:key="id" class="collection-item" data-id="{{item.id}}" bindtap="open" aria-role="button" aria-label="{{'查看'+item.zh+'的收藏卡'}}"><view class="collection-card"><collectible card="{{item}}"/></view><text class="card-caption">{{item.zh}}</text></view></view>
 <view wx:else class="card-shelf"><swiper class="shelf-swiper" current="{{shelfIndex}}" autoplay="{{false}}" circular="{{false}}" duration="{{reduceMotion?0:260}}" previous-margin="28rpx" next-margin="28rpx" bindchange="shelfChange"><swiper-item wx:for="{{cards}}" wx:key="id"><view class="shelf-item" data-id="{{item.id}}" bindtap="open" aria-role="button" aria-label="{{'查看'+item.zh+'的收藏卡'}}"><view class="shelf-card"><collectible card="{{item}}" large="{{true}}" motion="{{false}}"/></view><text class="card-caption">{{item.zh}}</text></view></swiper-item></swiper><view class="shelf-counter">{{shelfIndex+1}} / {{cards.length}} · 左右滑动，轻点查看</view></view></block>
 <view wx:else class="library-empty"><view class="section">拍下下一次遇见</view><text class="sub">你的第一张收藏卡，会从一次真实观察开始。</text><button class="primary" bindtap="explore">去拍一张</button></view>
 <view class="footprints-panel"><view class="section">我的足迹</view><text class="sub">只记录你主动保存的地点，仅本机查看；不公开精确位置。</text><view wx:for="{{footprints}}" wx:key="placeId" class="footprint-row"><text>{{item.label}}</text><text class="sub">{{item.count}} 次观察</text></view><text wx:if="{{!footprints.length}}" class="sub footprint-empty">暂无地点。可以在收藏卡详情自愿添加，不影响拍照与收藏。</text></view>
</view>
<navigation active="collection"/>
