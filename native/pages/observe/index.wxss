.shutter-card{padding:48rpx 25rpx 36rpx;border-radius:38rpx;background:#fff;box-shadow:0 8px 22px #18222a12;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16rpx;position:relative}.leaf-mark{position:absolute;left:62rpx;top:39rpx;color:#b7dfd1;font-size:45rpx;transform:rotate(-28deg)}.camera-symbol{height:150rpx;width:150rpx;border-radius:50%;background:#0e8a72;box-shadow:0 12px 30px #0e8a7240;display:flex;align-items:center;justify-content:center;color:#fff;font-size:61rpx;margin:0}.entry-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.entry-card{min-height:160rpx;box-sizing:border-box;padding:24rpx;border-radius:28rpx;background:#fff;border:1rpx solid #dedbd0;box-shadow:0 6rpx 16rpx #18222a0a;display:flex;flex-direction:column;gap:9rpx}.entry-icon{font-size:42rpx;color:#0e806c}.entry-title{font-size:28rpx;color:#0e806c;font-weight:600}.preview{width:100%;height:630rpx;border-radius:30rpx}.candidates{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:24rpx 0}.candidate{border-radius:18rpx;background:#f2f0ea;padding:8rpx;text-align:center;font-size:20rpx}.candidate image{width:100%;height:125rpx;border-radius:12rpx;display:block;margin-bottom:10rpx}.selected{background:#6fe0c0;box-shadow:0 0 0 2px #0e8a72}.odds-row{padding:12rpx 0}.recent{display:flex;gap:23rpx;margin-top:24rpx}.recent-card{width:calc((100vw - 122rpx)/3);height:calc((100vw - 122rpx)/3*1.4)}.camera-screen{position:fixed;top:0;bottom:0;left:0;right:0;background:#12221e;z-index:100}.camera-live{width:100%;height:100%}.camera-top{position:absolute;top:30rpx;left:30rpx;right:30rpx;display:flex;justify-content:space-between;color:#fff;font-size:28rpx}.camera-top>cover-view{padding:20rpx;background:#1b2a3380;border-radius:30rpx}.camera-bottom{position:absolute;bottom:50rpx;left:30rpx;right:30rpx;display:flex;justify-content:space-around;align-items:center;color:#fff;font-size:27rpx}.capture{width:140rpx;height:140rpx;line-height:140rpx;text-align:center;border:8rpx solid #fff;border-radius:100%;background:#0e8a72}.disabled{opacity:.45}.camera-error{position:absolute;top:40%;left:40rpx;right:40rpx;white-space:normal;color:#fff;line-height:1.7;text-align:center}.draft-row{display:flex;align-items:center;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid #d9d7c9;font-size:23rpx}.draft-row image{height:85rpx;width:85rpx;border-radius:12rpx}.draft-row text:last-child{margin-left:auto}
/* C theme alignment, preserving card and capture mechanics. */
.shutter-card,.entry-card{background:var(--surface);box-shadow:none;border:1rpx solid var(--line);border-radius:28rpx}.camera-symbol{position:relative;background:var(--orange);color:var(--paper);box-shadow:none}.camera-drawing::before{content:"";position:absolute;left:40rpx;top:50rpx;width:70rpx;height:50rpx;border:4rpx solid currentColor;border-radius:10rpx;box-sizing:border-box}.camera-drawing::after{content:"";position:absolute;left:61rpx;top:62rpx;width:28rpx;height:28rpx;border:4rpx solid currentColor;border-radius:50%;box-sizing:border-box}.entry-icon{position:relative;width:44rpx;height:44rpx;color:var(--lake)}.album-drawing{border:3rpx solid currentColor;border-radius:6rpx}.album-drawing::after{content:"";position:absolute;left:10rpx;bottom:7rpx;width:20rpx;height:17rpx;border-left:3rpx solid currentColor;border-top:3rpx solid currentColor;transform:rotate(45deg)}.habitat-drawing{border:3rpx solid currentColor;border-radius:50%}.habitat-drawing::after{content:"";position:absolute;left:11rpx;top:5rpx;width:12rpx;height:24rpx;background:currentColor;transform:rotate(35deg);border-radius:80% 0}.entry-title{color:var(--ink)}.candidate{font-size:24rpx;background:var(--surface);border:1rpx solid var(--line);word-break:break-all}.candidate.selected{background:#E7EBD9;box-shadow:none;border:3rpx solid var(--moss)}.capture{background:#B8492A;border-color:#FFF8E8}.camera-bottom{bottom:calc(32rpx + env(safe-area-inset-bottom))}.draft-row image{flex:none}.draft-row text{min-width:0;word-break:break-all}.draft-row text:last-child{font-size:24rpx;max-width:40%}
