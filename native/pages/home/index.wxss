.explore-top{display:flex;justify-content:space-between;align-items:center;gap:24rpx}.brand{font-size:30rpx;font-weight:600}.eyebrow{font-size:24rpx;color:var(--muted);letter-spacing:.06em}
.museum-today{display:flex;align-items:center;gap:24rpx;min-height:420rpx;padding:40rpx 0 24rpx}.museum-greeting{flex:1;min-width:0}.museum-greeting .title{font-size:42rpx;margin:16rpx 0 24rpx}.museum-greeting>.sub{display:block}.museum-hero-card,.museum-empty-frame{width:250rpx;height:350rpx;flex:none}.museum-empty-frame{border:1rpx solid var(--line);border-radius:var(--radius-card);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;padding:24rpx;text-align:center;background:var(--surface);font-size:28rpx}
.record-area{display:flex;align-items:center;gap:24rpx;margin:8rpx 0 32rpx}.home-record{flex:1;font-size:30rpx}.album-entry{background:none;min-height:88rpx;padding:16rpx 0;font-size:26rpx;color:var(--ink)}
.today-heading{margin-top:24rpx}.today-heading .link{flex:none}.today-scroll{width:100%;height:380rpx}.today-strip{display:flex;gap:20rpx;padding:12rpx 0 20rpx}.today-card{width:248rpx;height:348rpx;flex:none}.today-empty{display:flex;flex-direction:column;gap:12rpx;padding:28rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);font-size:28rpx}.recent-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx;margin-top:24rpx}.recent-card{aspect-ratio:5/7;min-width:0}.quiet-empty{padding:24rpx 0;color:var(--muted);font-size:28rpx;line-height:1.65}
.past-section{margin-top:56rpx;padding-top:28rpx;border-top:1rpx solid var(--line)}.past-section>.section{margin:12rpx 0 20rpx}.memory-row{display:flex;align-items:center;gap:24rpx;margin-top:24rpx;font-size:30rpx}.memory-row>view:last-child{flex:1;min-width:0}.memory-card{width:188rpx;height:264rpx;flex:none}
.return-top{position:fixed;right:24rpx;bottom:calc(156rpx + env(safe-area-inset-bottom));z-index:19;min-height:88rpx;padding:20rpx 24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:22rpx;color:var(--ink);font-size:24rpx}
@media(max-width:350px){.museum-today{gap:16rpx}.museum-hero-card,.museum-empty-frame{width:220rpx;height:308rpx}.museum-greeting .title{font-size:38rpx}.record-area{gap:16rpx}}
.reduce-motion .home-record{transition:none;transform:none}
.world-canvas{position:relative;min-height:48vh;display:flex;flex-direction:column;margin:24rpx -8rpx 32rpx;padding:28rpx 20rpx 20rpx;background:#EBEDE2;border-radius:28rpx;overflow:hidden}.world-heading{position:relative;z-index:1}.world-heading .title{margin:12rpx 0;font-size:44rpx}.world-heading>.sub{display:block;max-width:30ch}.world-specimens{flex:1;min-height:300rpx;display:flex;align-items:center;justify-content:center;gap:14rpx;padding:24rpx 0}.world-specimen{width:30%;aspect-ratio:5/7;min-width:0;transform:rotate(-5deg)}.specimen-1{transform:translateY(-14rpx) rotate(2deg)}.specimen-2{transform:rotate(7deg)}.world-caption{position:relative;font-size:24rpx;color:#586459;margin-top:auto}.world-empty{position:relative;flex:1;min-height:260rpx;display:flex;align-items:center;justify-content:center}.world-empty-copy{position:relative;text-align:center;display:flex;flex-direction:column;gap:14rpx;font-size:28rpx;padding:32rpx 16rpx}.world-contour{position:absolute;width:120%;height:180rpx;border:1rpx solid #C6CDBD;border-radius:50%;transform:rotate(-12deg);bottom:-60rpx;left:-20%}.contour-two{bottom:-100rpx;left:15%;transform:rotate(12deg)}.world-caption,.world-empty-copy{overflow-wrap:anywhere}
