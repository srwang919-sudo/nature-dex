.library-heading .title{font-size:44rpx;color:var(--ink)}.eyebrow{display:block;color:var(--moss);font-size:24rpx;margin-bottom:10rpx}.layout-switch{display:flex;gap:16rpx;margin:28rpx 0}.layout-button{flex:1;min-height:88rpx;border:1rpx solid var(--line);border-radius:24rpx;background:var(--surface);color:var(--ink);font-size:26rpx}.layout-button.selected{background:#E7EBD9;border-color:var(--moss);font-weight:600}/* 网格改 flex 居中：只剩一张卡、或最后一行为奇数时也能居中，不再贴左 */
.card-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:24rpx;align-items:flex-start}
.collection-item{flex:0 0 calc((100% - 24rpx)/2);min-width:0;min-height:88rpx}
@media(min-width:480px){.library-page{max-width:760rpx;margin:0 auto}.collection-item{flex-basis:calc((100% - 48rpx)/3)}}.collection-card{width:100%;aspect-ratio:5/7}.collection-card collectible{display:block;width:100%;height:100%}.library-empty,.footprints-panel{border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface);padding:28rpx 24rpx}.library-empty{text-align:center}.library-empty .sub{display:block;margin:12rpx 0 24rpx}.footprints-panel{margin-top:32rpx}.footprints-panel>.sub{display:block;margin-top:12rpx;line-height:1.6}.footprint-row{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx solid var(--line);padding:22rpx 0;margin-top:14rpx;font-size:26rpx;overflow-wrap:anywhere}.footprint-row>.sub{flex:none}.footprint-empty{padding:10rpx 0}.reduce-motion .collection-item{transition:none;animation:none}

.card-shelf{min-width:0}.shelf-swiper{height:820rpx;width:100%}.shelf-item{padding:0 20rpx;box-sizing:border-box;text-align:center}.shelf-card{width:100%;max-width:480rpx;aspect-ratio:5/7;margin:0 auto}.shelf-card collectible{display:block;width:100%;height:100%}.shelf-counter{text-align:center;font-size:24rpx;color:var(--muted);line-height:1.5}.reduce-motion .shelf-item{transition:none;animation:none}
.library-search{display:flex;align-items:center;gap:12rpx;margin-top:24rpx}
.search-input{flex:1;min-width:0;min-height:var(--tap-min);padding:0 24rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-md);font-size:28rpx}
.search-clear{flex:none;min-height:var(--tap-min);padding:0 24rpx;font-size:26rpx;color:var(--color-text-secondary);background:var(--color-surface-2);border:1rpx solid var(--color-border);border-radius:var(--radius-md)}
