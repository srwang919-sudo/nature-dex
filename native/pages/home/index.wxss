.explore-top{display:flex;justify-content:space-between;align-items:center;gap:24rpx}.brand{font-size:30rpx;font-weight:600}.eyebrow{font-size:24rpx;color:var(--muted);letter-spacing:.06em}
.record-area{display:flex;align-items:center;gap:24rpx;margin:8rpx 0 32rpx}.home-record{flex:1;font-size:30rpx}.album-entry{background:none;min-height:88rpx;padding:16rpx 0;font-size:26rpx;color:var(--ink)}
.today-heading{margin-top:24rpx}.today-heading .link{flex:none}.today-scroll{width:100%;height:380rpx}.today-strip{display:flex;gap:20rpx;padding:12rpx 0 20rpx}.today-card{width:248rpx;height:348rpx;flex:none}.today-empty{display:flex;flex-direction:column;gap:12rpx;padding:28rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);font-size:28rpx}.recent-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx;margin-top:24rpx}.recent-card{aspect-ratio:5/7;min-width:0}.quiet-empty{padding:24rpx 0;color:var(--muted);font-size:28rpx;line-height:1.65}
.past-section{margin-top:56rpx;padding-top:28rpx;border-top:1rpx solid var(--line)}.past-section>.section{margin:12rpx 0 20rpx}.memory-row{display:flex;align-items:center;gap:24rpx;margin-top:24rpx;font-size:30rpx}.memory-row>view:last-child{flex:1;min-width:0}.memory-card{width:188rpx;height:264rpx;flex:none}
.return-top{position:fixed;right:24rpx;bottom:calc(156rpx + env(safe-area-inset-bottom));z-index:19;min-height:88rpx;padding:20rpx 24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:22rpx;color:var(--ink);font-size:24rpx}
.reduce-motion .home-record{transition:none;transform:none}
.world-canvas{position:relative;min-height:48vh;display:flex;flex-direction:column;margin:24rpx -8rpx 32rpx;padding:28rpx 20rpx 20rpx;background:#EBEDE2;border-radius:28rpx;overflow:hidden}.world-heading{position:relative;z-index:1}.world-heading .title{margin:12rpx 0;font-size:44rpx}.world-heading>.sub{display:block;max-width:30ch}.world-caption{position:relative;font-size:22rpx;color:#586459;margin-top:auto;overflow-wrap:anywhere}.world-ecosystem{position:relative;flex:1;min-height:470rpx;margin:12rpx -8rpx 16rpx}.scene-canopy{position:absolute;top:5%;left:0;width:62%;height:43%;border:1rpx solid #C3CCB9;border-radius:48% 55% 38% 50%;background:#E0E6D8}.scene-branch{position:absolute;left:29%;top:34%;height:35%;width:30%;border-bottom:2rpx solid #B6BEAC;border-left:2rpx solid #B6BEAC;border-radius:0 0 0 20rpx}.scene-ground{position:absolute;bottom:1%;left:-12%;height:28%;width:125%;border-top:1rpx solid #BBC6AF;border-radius:50% 50% 0 0;background:#E1E5D5}.scene-water{position:absolute;bottom:3%;right:-7%;width:43%;height:19%;border:1rpx solid #BECDD0;border-radius:50%;background:#DBE5E4}.world-specimen{position:absolute;width:23%;height:37%;min-width:0;z-index:1}.zone-canopy{left:7%;top:4%}.zone-canopy.slot-1{left:32%;top:9%}.zone-branch{left:51%;top:29%}.zone-branch.slot-1{left:75%;top:24%}.zone-ground{left:6%;bottom:0}.zone-ground.slot-1{left:31%;bottom:0}.zone-water{right:15%;bottom:0}.zone-water.slot-1{right:0;bottom:18%}.world-empty-copy{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;font-size:28rpx;padding:24rpx;text-align:center}.world-empty-copy>.sub{max-width:25ch}
@media(max-width:390px){.world-heading .title{font-size:40rpx}.world-ecosystem{min-height:450rpx}.world-caption{font-size:24rpx;line-height:1.5}}
@media(max-width:320px){.world-canvas{padding:24rpx 16rpx}.world-ecosystem{min-height:490rpx}.world-heading .title{font-size:38rpx}.world-specimen{width:25%;height:35%}.record-area{gap:16rpx}.album-entry{font-size:28rpx}}
