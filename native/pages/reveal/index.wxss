.reveal-page{padding-top:24rpx}.new-badge{background:#E9E5D5;color:var(--ink);border-radius:12rpx;padding:12rpx 18rpx;font-size:24rpx}.stage{width:480rpx;max-width:100%;height:672rpx;margin:40rpx auto 24rpx;position:relative;perspective:1400rpx}.hero-card{width:100%;height:100%;position:relative;z-index:1}.arrive{animation:arrive .24s cubic-bezier(.22,1,.36,1)}.observation{margin-top:24rpx;font-size:26rpx}.light{position:absolute;inset:-5%;background:radial-gradient(ellipse,#CCD8BE77,transparent 70%);animation:glow .3s ease-out forwards;pointer-events:none}@keyframes arrive{from{opacity:.4;transform:scale(.98)}to{opacity:1;transform:scale(1)}}@keyframes glow{from{opacity:.7}to{opacity:0}}.reduce-motion .arrive,.reduce-motion .light{animation:none}
.discovery{min-height:calc(100vh - 210rpx);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:28rpx 0 48rpx}.discovery-kicker{font-size:25rpx;color:var(--moss);letter-spacing:3rpx}.discovery-orbit{position:relative;width:440rpx;height:440rpx;display:flex;align-items:center;justify-content:center;margin:38rpx 0 30rpx}.discovery-glow{position:absolute;inset:-18rpx;border-radius:50%;background:radial-gradient(circle,#BCDCAA 0%,#DBEACC 50%,#FFF8E800 72%)}.discovery-photo{position:relative;width:334rpx;height:334rpx;border-radius:50%;border:8rpx solid var(--surface);z-index:1}.discovery-stars{position:absolute;inset:0;z-index:2;pointer-events:none}.discovery-stars view{position:absolute;width:14rpx;height:14rpx;background:var(--sun);transform:rotate(45deg);top:32rpx;left:70rpx}.discovery-stars view:nth-child(2){top:140rpx;left:auto;right:12rpx;width:20rpx;height:20rpx}.discovery-stars view:nth-child(3){top:auto;bottom:44rpx;left:30rpx;width:12rpx;height:12rpx}.discovery-name{font-size:50rpx;font-weight:600;color:var(--ink);max-width:100%;word-break:break-all}.discovery-latin{font-size:24rpx;color:var(--muted);margin-top:8rpx;overflow-wrap:anywhere}.discovery-title{font-size:29rpx;font-weight:600;color:var(--ink);margin-top:26rpx}.discovery-note{font-size:24rpx;color:var(--muted);margin:10rpx 0 28rpx}.discovery-continue{width:100%;margin:10rpx 0 18rpx}.discovery-motion .discovery-photo{animation:discovery-found .5s cubic-bezier(.22,1,.36,1) both}.discovery-motion .discovery-glow{animation:discovery-glow .65s ease-out both}.discovery-motion .discovery-stars{animation:discovery-stars .6s ease-out both}@keyframes discovery-found{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}@keyframes discovery-glow{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}@keyframes discovery-stars{from{opacity:0;transform:scale(.75)}to{opacity:1;transform:scale(1)}}.reduce-motion .discovery-photo,.reduce-motion .discovery-glow,.reduce-motion .discovery-stars{animation:none}
.badge-reveal-overlay{position:fixed;inset:0;z-index:90;background:rgba(20,43,34,.6);display:flex;align-items:center;justify-content:center;padding:40rpx}.badge-reveal-panel{width:100%;max-width:600rpx;padding:40rpx;background:#fffbf2;border-radius:28rpx;text-align:center}.badge-reveal-image{display:block;width:320rpx;height:320rpx;margin:20rpx auto}.badge-unavailable{padding:70rpx 0;color:#58655d}.badge-animate .badge-reveal-panel{animation:badge-unlock .5s ease-out both}.reduce-motion .badge-reveal-panel{animation:none;transform:none}@keyframes badge-unlock{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
.discovery-orbit{height:480rpx;max-width:100%;margin:28rpx 0 24rpx}.discovery-photo{width:360rpx;height:450rpx;border:0;border-radius:16rpx;background:transparent}.discovery-glow{background:radial-gradient(circle,#D6DFCA77,transparent 72%)}.discovery-stars{display:none}.discovery-latin{font-family:Georgia,serif;font-style:italic}.badge-reveal-panel{background:var(--paper);border-radius:28rpx}
