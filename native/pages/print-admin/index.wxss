/* 打印履约后台（§14）：内部工具页，沿用设计 token，不做动效。 */
.print-admin{display:flex;flex-direction:column;gap:8rpx}
.print-admin .title{font-size:var(--text-xl);color:var(--color-text)}
.print-admin .section{font-size:30rpx;color:var(--color-text)}
.admin-count{flex:none;font-size:26rpx;color:var(--color-primary)}
.admin-error{padding:20rpx var(--space-md);background:var(--color-danger-surface);border:1rpx solid var(--color-danger-border);border-radius:20rpx;color:var(--color-danger-text);font-size:26rpx;line-height:1.6;overflow-wrap:anywhere}
.admin-list{display:flex;flex-direction:column;gap:20rpx}
.admin-card{padding:var(--space-md);background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:22rpx}
.admin-title{font-size:30rpx;color:var(--color-text)}
.admin-pill{flex:none;font-size:24rpx;padding:6rpx 14rpx;border:1rpx solid var(--color-border);border-radius:999rpx;color:var(--color-primary)}
.admin-actions{display:flex;gap:var(--space-sm);margin-top:20rpx}
.admin-actions .grow{flex:1;min-width:0}
.admin-tracking{display:flex;align-items:center;gap:12rpx;margin-top:var(--space-sm)}
.admin-picker{min-height:76rpx;padding:18rpx var(--space-sm);font-size:26rpx;color:var(--color-text);background:var(--color-surface-2);border:1rpx solid var(--color-border);border-radius:var(--radius-md)}
.admin-input{flex:1;min-width:0;min-height:76rpx;padding:var(--space-sm);font-size:26rpx;background:var(--color-surface-2);border:1rpx solid var(--color-border);border-radius:var(--radius-md)}
.print-admin button{min-height:80rpx}
