.library-page{padding-top:50rpx}.library-heading{padding:0 4rpx 14rpx}.eyebrow{display:block;color:#877557;font-size:17rpx;letter-spacing:3rpx;margin-bottom:10rpx}.library-heading .title{font-size:48rpx;color:#17352d}.chapter-panel{margin-top:22rpx;padding:24rpx;border:1rpx solid #d8d0c1;background:#fffdf6}.chapter-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:18rpx 0}.chapter-cell{height:126rpx;overflow:hidden;border:1rpx solid #ddd5c7;background:#f7f3e9}.chapter-cell.lit{border-color:#174f42;background:#e0eadf}.chapter-cell image{display:block;width:100%;height:100%}.chapter-placeholder{height:100%;display:flex;align-items:center;justify-content:center;color:#aca392;background:linear-gradient(135deg,#f7f3e9,#eee8db);font-size:19rpx;letter-spacing:1rpx}.filter-group{margin-top:24rpx}.filter-group.compact{margin-top:14rpx}.filter-label{display:block;font-size:20rpx;color:#6f7165;margin-bottom:10rpx;letter-spacing:1rpx}.filter-scroll{width:100%;white-space:nowrap}.filter-row{display:flex;gap:12rpx;padding-right:12rpx}.filter-pill{display:inline-flex;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx;padding:0 18rpx;border:1rpx solid #cfc8b9;border-radius:99rpx;color:#59655d;background:#fffdf6;font-size:22rpx;transition:transform .14s}.filter-pill:active,.collection-card:active,.example-item:active{transform:scale(.98)}.filter-pill.on{color:#fffdf6;background:#174f42;border-color:#174f42}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx;margin-top:30rpx}.collection-card{height:389rpx;min-width:0;transition:transform .14s}.collection-card collectible{display:block;width:100%;height:100%}.library-empty{margin-top:42rpx;padding:62rpx 30rpx 36rpx;text-align:center;border:1rpx solid #d8d0c1;background:#fffdf6}.empty-mark{display:block;font-size:50rpx;color:#b9a77e;margin-bottom:12rpx}.library-empty .sub{display:block;margin:10rpx 0 26rpx}.library-empty .primary{width:100%}.example-section{margin-top:44rpx;padding:24rpx 0 10rpx;border-top:1rpx solid #d8d0c1}.example-note{display:block;margin:12rpx 0 16rpx;color:#697269;font-size:21rpx;line-height:1.55}.example-scroll{height:430rpx;width:100%;white-space:nowrap}.example-strip{display:flex;gap:18rpx;padding:2rpx 16rpx 20rpx 2rpx}.example-item{width:278rpx;min-width:278rpx;height:389rpx;position:relative;transition:transform .14s}.example-item collectible{display:block;width:100%;height:100%}
.library-page{padding-top:32rpx}.library-heading{padding:0}.eyebrow{color:var(--moss);font-size:24rpx;letter-spacing:0}.library-heading .title{font-size:44rpx;color:var(--ink)}
.chapter-panel{background:var(--surface);border-color:var(--line);border-radius:28rpx;padding:24rpx}.chapter-cell{border-radius:16rpx;background:var(--paper);border-color:var(--line)}.chapter-placeholder{background:var(--paper);font-size:24rpx;color:var(--muted);letter-spacing:0}.chapter-cell.lit{border-color:var(--moss)}
.chapter-stamps{display:flex;gap:12rpx;margin:20rpx 0}.chapter-stamp{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;border:1rpx dashed var(--line);border-radius:18rpx;padding:12rpx 6rpx;font-size:24rpx;color:var(--muted)}.chapter-stamp.earned{background:#E7EBD9;color:var(--ink);border:1rpx solid var(--moss)}.stamp-state{font-size:22rpx}
.filter-label{font-size:24rpx;color:var(--muted);letter-spacing:0}.filter-pill{font-size:24rpx;background:var(--surface);border-color:var(--line);color:var(--ink);gap:8rpx}.filter-pill.on{color:var(--ink);background:#E7EBD9;border-color:var(--moss)}.selected-dot{width:10rpx;height:10rpx;background:var(--ink);border-radius:50%}
.collection-card{height:auto;aspect-ratio:5/7}.library-empty{border-color:var(--line);background:var(--surface);border-radius:28rpx;padding:32rpx 24rpx}.example-section{border-color:var(--line)}.example-note{font-size:24rpx;color:var(--muted)}
.reduce-motion .filter-pill,.reduce-motion .collection-card,.reduce-motion .example-item{transition:none;transform:none}
