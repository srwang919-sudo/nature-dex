/* 自然旅程 · 旅行手帐 */
.journey-hero{padding-bottom:28rpx;border-bottom:1rpx solid var(--color-border);margin-bottom:28rpx}
.journey-hero .eyebrow{display:block;color:var(--moss);font-size:22rpx;margin-bottom:10rpx;letter-spacing:.08em}
.journey-hero .title{font-size:44rpx;color:var(--ink);margin:6rpx 0}
.journey-hero .sub{display:block;font-size:24rpx;color:var(--muted);margin-top:10rpx;max-width:42ch}

.journey-page>.title{margin-top:8rpx}
.journey-empty{padding:72rpx 0;max-width:620rpx;text-align:center}
.journey-empty>.sub{display:block;margin-top:24rpx}

.journey-compass{display:flex;justify-content:space-around;gap:16rpx;margin:24rpx 0 36rpx;padding:24rpx 16rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm)}
.compass-cell{display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:24rpx;color:var(--color-text-secondary);min-width:0}
.compass-cell .number{font-family:Georgia,serif;font-size:44rpx;color:var(--color-text);line-height:1.1;font-weight:600}

.journey-journal{margin-top:8rpx;display:flex;flex-direction:column;gap:40rpx}
.journal-entry{background:var(--surface);border:1rpx solid var(--line);border-radius:var(--radius-card);overflow:hidden;transition:transform .24s cubic-bezier(.22,1,.36,1)}
.journal-entry:active{transform:scale(.985)}
.journey-cover{height:420rpx;padding:12rpx;background:var(--color-surface-2)}
.journey-cover collectible{display:block;width:100%;height:100%}
.journal-copy{padding:24rpx 26rpx 28rpx;display:flex;flex-direction:column;gap:10rpx}
.journal-place{font-family:var(--font-heading);font-size:34rpx;line-height:1.35;overflow-wrap:anywhere}
.journal-date{font-size:24rpx;color:var(--muted)}
.journal-note{font-size:26rpx;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
.journal-open{font-size:24rpx;color:var(--moss);margin-top:8rpx}
.detail-entry{margin-top:28rpx}
.detail-note{font-size:26rpx;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8}
.journal-entry .link{text-align:left;padding-left:0}

.landmark-panel{margin-top:32rpx;padding:24rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg)}
.landmark-panel>.sub{display:block;margin-top:8rpx}
.landmark{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-top:1rpx solid var(--color-border);font-size:26rpx;overflow-wrap:anywhere}
.landmark:first-of-type{border-top:0;margin-top:12rpx}
.landmark-marker{width:32rpx;height:32rpx;flex:none;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--color-accent);border:2rpx solid var(--color-surface-1);box-shadow:var(--shadow-sm)}
.landmark-count{margin-left:auto;flex:none;color:var(--color-text-secondary);font-size:24rpx}

/* 旅程地图 */
.journey-map{position:relative;height:420rpx;margin-top:28rpx;border-radius:var(--radius-xl);overflow:hidden;border:1rpx solid var(--color-border);box-shadow:var(--shadow-md);background:#EFEFE6}
.map-base{position:absolute;inset:0;width:100%;height:100%}
.map-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:1}
.map-compass{position:absolute;right:20rpx;top:20rpx;z-index:3;width:56rpx;height:56rpx;border-radius:50%;background:rgba(255,255,255,.82);border:1rpx solid var(--color-border);display:flex;align-items:center;justify-content:center}
.map-compass::before{content:'';width:0;height:0;border-left:9rpx solid transparent;border-right:9rpx solid transparent;border-bottom:20rpx solid var(--color-danger)}
.map-compass::after{content:'';position:absolute;bottom:12rpx;width:0;height:0;border-left:9rpx solid transparent;border-right:9rpx solid transparent;border-top:20rpx solid var(--color-text-secondary);opacity:.5}
.map-scale{position:absolute;left:20rpx;bottom:18rpx;z-index:3;display:flex;align-items:center;gap:8rpx;font-size:20rpx;color:var(--color-text-secondary)}
.map-scale-rule{width:64rpx;height:8rpx;border:1rpx solid var(--color-text-secondary);border-top:0}

.map-node{position:absolute;z-index:2;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx}
.node-pin{width:26rpx;height:26rpx;border-radius:50%;background:var(--color-primary);border:4rpx solid #FFFFFF;box-shadow:0 2rpx 8rpx rgba(44,62,53,.4)}
.map-node.is-latest .node-pin{background:var(--color-accent)}
.node-tag{margin-top:8rpx;padding:3rpx 12rpx;border-radius:var(--radius-sm);background:rgba(255,255,255,.92);border:1rpx solid var(--color-border);font-size:20rpx;line-height:1.4;color:var(--color-text);white-space:nowrap}

.map-bubble{position:absolute;z-index:4;min-width:200rpx;max-width:340rpx;padding:16rpx 20rpx;background:#FFFFFF;border-radius:var(--radius-md);box-shadow:0 8rpx 20rpx rgba(44,62,53,.22);transform:translate(-50%,-140%)}
.map-bubble::after{content:'';position:absolute;left:50%;bottom:-10rpx;width:0;height:0;margin-left:-9rpx;border-left:9rpx solid transparent;border-right:9rpx solid transparent;border-top:12rpx solid #FFFFFF}
.map-bubble.side-right{transform:translate(-8%,-140%)}
.map-bubble.side-left{transform:translate(-92%,-140%)}
.bubble-place{font-size:26rpx;color:var(--color-text);overflow-wrap:anywhere}
.bubble-date{margin-top:6rpx;display:flex;align-items:center;gap:16rpx;font-size:24rpx;color:var(--color-text-secondary)}
.bubble-close{flex:none;color:var(--color-primary);display:flex;align-items:center;min-height:88rpx;padding:0 8rpx;margin:-16rpx 0}
.map-node.is-active .node-pin{background:var(--color-accent);box-shadow:0 0 0 6rpx rgba(212,165,116,.28)}

.reduce-motion .journal-entry{transition:none}
@media(max-width:340px){.journey-map{height:420rpx}.node-tag{font-size:19rpx}.journey-cover{height:360rpx}}
