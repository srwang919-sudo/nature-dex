.mine-page{padding-top:40rpx}.profile{display:flex;align-items:center;gap:22rpx}.profile-mark{width:88rpx;height:88rpx;flex:none;border-radius:50%;background:var(--color-primary-light);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:26rpx}.profile>view:last-child{min-width:0}.profile .title{font-size:44rpx}
.settings-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:28rpx}.settings-sections button{min-width:0;font-size:26rpx;padding:18rpx 12rpx;min-height:88rpx}.setting-card{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:24rpx 0;margin-top:16rpx;border-top:1rpx solid var(--line)}.setting-card>view{flex:1;min-width:0}.setting-card .section{font-size:30rpx}.setting-card .sub{margin-top:8rpx;line-height:1.65}.setting-card switch{flex:none}.help-copy{font-size:28rpx;line-height:1.8;margin-top:20rpx;overflow-wrap:anywhere}
.service-input{min-height:88rpx;padding:0 20rpx;border:1rpx solid var(--line);border-radius:var(--radius-action);font-size:28rpx;background:var(--surface)}.service-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}.service-row>text,.service-row>view:first-child{min-width:0;flex:1;overflow-wrap:anywhere}.service-row button{font-size:24rpx;flex-shrink:0;min-height:88rpx}.social-card-actions{display:flex;flex-direction:column;gap:12rpx;max-width:48%}.social-card-actions button{white-space:normal;min-height:88rpx}.ops-result{padding:22rpx;border-radius:var(--radius-card);background:var(--surface);border:1rpx solid var(--line);font-size:26rpx;line-height:1.7;white-space:pre-line;overflow-wrap:anywhere}.availability-links{display:flex;gap:12rpx;margin-top:24rpx;flex-wrap:wrap}.availability-links button{flex:1;min-width:220rpx;font-size:24rpx;padding:20rpx 12rpx}.danger{color:var(--color-danger)}
@media(max-width:340px){.service-row{flex-wrap:wrap}.social-card-actions{max-width:100%;width:100%;flex-direction:row}.social-card-actions button{flex:1;min-width:0}}
