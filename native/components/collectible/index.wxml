<view wx:if="{{scene}}" class="scene-art"><image wx:if="{{!imageUnavailable && presentation.front.photo}}" class="scene-image" src="{{useThumb?thumbUrl:presentation.front.photo}}" mode="aspectFit" binderror="imageError"/><image wx:else class="scene-unavailable" src="/assets/theme/share-safe-leaf.png" mode="aspectFit"/><text class="scene-name">{{presentation.front.name}}</text></view>
<view wx:else class="physical {{originalPhoto?'photo-only':''}} {{presentation.front.finishKey}} {{large?'large':''}} {{motion?'moving':''}}">
  <view wx:if="{{!back}}" class="inner">
    <image wx:if="{{!imageUnavailable && presentation.front.photo}}" class="photo" src="{{useThumb?thumbUrl:presentation.front.photo}}" mode="aspectFill" binderror="imageError"/>
    <view wx:else class="photo photo-fallback"><text>{{mediaDenied?'图片未加载':'图片暂时无法读取'}}</text><text>{{mediaDenied?'开启云恢复后查看':'请稍后重试'}}</text></view>
    <view class="metadata {{presentation.front.expanded?'expanded-metadata':''}}"><view class="name-row"><text class="name">{{presentation.front.name}}</text></view><text class="latin">{{presentation.front.secondaryName}}</text><view wx:if="{{presentation.front.expanded}}" class="front-context"><text class="front-context-item">{{presentation.front.categoryLabel}}</text><text class="front-context-item">{{presentation.front.locationLabel}}</text></view><text wx:if="{{large&&presentation.front.shortStory}}" class="specimen-story">{{presentation.front.shortStory}}</text><view wx:if="{{presentation.front.no||(large&&presentation.front.date)}}" class="specimen-footer"><text>{{presentation.front.no}}</text><text wx:if="{{large}}">{{presentation.front.date}}</text></view></view>
    <view wx:if="{{card.sample}}" class="sample">示例</view>
  </view>
  <view wx:else class="back">
    <view class="back-art"><image wx:if="{{!backUnavailable && presentation.back.illustration}}" class="back-illustration-full" src="{{presentation.back.illustration}}" binderror="artError" mode="aspectFill"/><text wx:else>{{presentation.back.kind==='original'?'原照片暂时无法读取，请稍后重试':'水彩插画暂时无法读取，请稍后重试'}}</text></view>
    <text wx:if="{{presentation.back.kind==='original'}}" class="original-label">实拍原照 · {{presentation.back.locationLabel}}</text>
    <view class="back-bottom" wx:if="{{presentation.back.no || presentation.back.date}}"><view class="record-footer-line"><text wx:if="{{presentation.back.no}}">{{presentation.back.no}}</text><text wx:if="{{presentation.back.date}}">{{presentation.back.date}}</text></view></view>
  </view>
</view>
