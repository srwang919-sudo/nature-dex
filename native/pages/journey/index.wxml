<view class="page journey-page {{reduceMotion?'reduce-motion':''}}">
 <text class="sub">留给未来的自己</text><view class="title">自然旅程</view>
 <view wx:if="{{!journeys.length}}" class="journey-empty"><view class="section">第一次遇见，值得记下来。</view><text class="sub">同一种生命，一次又一次相逢。</text><button class="primary spaced" bindtap="capture">拍一张</button></view>
 <view wx:for="{{journeys}}" wx:key="speciesId" class="species-journey"><view class="journey-heading"><view class="journey-portrait" data-id="{{item.card.id}}" bindtap="open" aria-role="button" aria-label="{{'回看'+item.name}}"><collectible card="{{item.card}}" scene="{{true}}"/></view><view class="journey-heading-copy"><view class="section">{{item.name}}</view><text class="sub">{{item.count}} 次真实遇见</text></view></view><view class="observation-thread"><button wx:for="{{item.observations}}" wx:for-item="record" wx:key="id" class="observation-entry" data-id="{{record.id}}" bindtap="open"><view class="thread-dot"/><text>{{record.dateLabel}}</text><text class="thread-link">回看记录</text></button></view></view>
 <view wx:if="{{places.length}}" class="spaced"><view class="section">走过的地方</view><text class="sub">你主动留下的地点，仅自己可见</text><view wx:for="{{places}}" wx:key="placeId" class="place-row"><text>{{item.label}}</text><text class="sub">{{item.count}} 次遇见</text></view></view>
</view><navigation active="journey"/>
