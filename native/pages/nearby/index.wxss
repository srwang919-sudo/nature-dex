.nearby-page{padding-top:42rpx}.privacy-card,.season-card,.etiquette-card{padding:28rpx;border-radius:30rpx;border:1rpx solid #ead8aa;background:#fff3d4}.season-card{background:#fff;border-color:#dfddd3;box-shadow:0 6rpx 18rpx #18222a0a}.etiquette-card{background:#fff8e6}.sort-pill,.season-pill{padding:11rpx 18rpx;border:1rpx solid #d6d5cf;border-radius:40rpx;background:#fff;color:#41505b;font-size:21rpx}.habitat{display:flex;align-items:center;gap:20rpx;padding:22rpx;border-radius:28rpx;background:#fff;border:1rpx solid #dfddd3;box-shadow:0 6rpx 18rpx #18222a0a;margin-bottom:18rpx;min-height:132rpx;transition:transform .14s}.habitat:active{transform:scale(.98)}.habitat image{width:112rpx;height:132rpx;border-radius:20rpx;flex:none}.latin-row{font-style:italic;margin-bottom:4rpx}.season-pill{flex:none;text-align:center;max-width:145rpx;line-height:1.3}
/* C theme alignment, preserving card and capture mechanics. */
.privacy-card,.season-card,.etiquette-card{background:var(--surface);border-color:var(--line);box-shadow:none}.privacy-card{background:#EAF0E4}.habitat{background:var(--surface);border-color:var(--line);box-shadow:none;transition:none}.habitat:active{transform:none}.sort-pill,.season-pill{background:var(--paper);color:var(--ink);border-color:var(--line);font-size:24rpx}.habitat .section{font-size:30rpx}.habitat{flex-wrap:wrap}.habitat .grow{flex-basis:250rpx}.season-pill{max-width:100%;margin-left:auto}
/* ===== 地区图鉴（§11）：本季清单进度，只用本机数据 ===== */
.atlas-card{padding:28rpx 24rpx;background:var(--surface,#FFFCF4);border:1rpx solid var(--line,#DED8C6);border-radius:24rpx}
.atlas-progress{flex:none;font-size:30rpx;color:var(--moss,#647B42)}
.atlas-bar{height:12rpx;margin-top:20rpx;background:var(--paper,#FFF8E8);border:1rpx solid var(--line,#DED8C6);border-radius:999rpx;overflow:hidden}
.atlas-bar-fill{height:100%;background:var(--moss,#647B42);border-radius:999rpx;transition:width .4s ease}
.atlas-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:24rpx}
.atlas-item{display:flex;flex-direction:column;gap:8rpx;min-width:0;padding:18rpx 16rpx;border:1rpx solid var(--line,#DED8C6);border-radius:18rpx;background:var(--paper,#FFF8E8)}
.atlas-item.found{border-color:var(--moss,#647B42);background:#F1F4E7}
.atlas-item.missing{opacity:.72}
.atlas-name{font-size:28rpx;color:var(--ink,#183F36);overflow-wrap:anywhere}
.atlas-habitat{font-size:22rpx;line-height:1.4;overflow-wrap:anywhere}
.atlas-places{display:flex;flex-direction:column;gap:14rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--line,#DED8C6)}
.atlas-place{display:flex;flex-direction:column;gap:6rpx;font-size:28rpx;color:var(--ink,#183F36);overflow-wrap:anywhere}
