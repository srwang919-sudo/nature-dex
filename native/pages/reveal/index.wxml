<view class="page reveal-page {{reduce?'reduce-motion':''}}"><block wx:if="{{card}}"><view class="row between"><view><view class="title">{{duplicate?'又遇见你了':'发现新物种！'}}</view><view class="sub">{{duplicate?'已收藏 · 第 '+(duplicate+1)+' 次观察':'首次记录 · 让这次遇见留下来'}}</view></view><text class="new-badge">{{duplicate?'＋1':'新记录'}}</text></view>
<view wx:if="{{card.artStatus==='fallback'}}" class="notice spaced">{{card.artMessage}}</view><view wx:if="{{card.artStatus==='ready'}}" class="notice spaced">AI 艺术卡面 · 原始照片保留 · 不作为鉴别依据</view><view wx:if="{{card.protection}}" class="notice spaced">{{card.protection}}</view><view class="stage {{card.finishKey}}"><view wx:if="{{opened&&!reduce}}" class="light"></view><view class="hero-card {{opened&&!reduce?'arrive':''}}" bindtap="flip"><collectible card="{{card}}" large="{{true}}" back="{{back}}" bind:recordtap="flip" motion="{{opened&&!reduce}}"/></view>
<view wx:if="{{!opened}}" class="seal {{holding?'holding':''}} stage-{{revealStage}}" bindtouchstart="hold" bindtouchend="release" bindtouchcancel="cancelReveal"><view class="seal-line"><text class="seal-brand">去大自然里</text><text class="seal-small">每一场遇见，都值得珍藏</text><view class="seal-mark">✧</view><text class="seal-title">有一份遇见，等你揭晓</text><text class="seal-small">按住片刻 · 打开这张收藏卡</text><view class="hold-track"><view></view></view><text class="seal-bottom">自然观察卡 · {{card.no}}</text></view></view></view>
<view class="hint">{{opened?'轻触卡片翻面 · 让这一刻有迹可循':'照片已保存，工艺已经封存'}}</view>
<button wx:if="{{direct&&!opened}}" class="link direct" bindtap="open">直接打开 →</button>
<view wx:if="{{opened}}" class="observation"><view class="row between"><text>{{duplicate?'已收藏 · 观察再深入一步':'第一份观察记录'}}</text><text class="green">{{duplicate+1}} 次</text></view><view class="track"><view class="fill" style="width:{{progress}}%"></view></view></view>
<button class="primary spaced" disabled="{{!opened}}" bindtap="collect">{{saved?'返回我的图鉴':'完成 · 收入图鉴'}}</button><view class="row spaced"><button class="secondary grow" disabled="{{!opened}}" bindtap="view">3D 查看</button><button class="secondary grow" bindtap="again">再拍一张</button></view><view class="hint spaced">确认记录 · {{card.finish}} · {{card.artStatus==='ready'?'AI 艺术卡面':'实拍照片'}}</view></block><view wx:else class="empty">这张卡暂时无法打开<button class="link" bindtap="again">返回拍摄</button></view></view>
