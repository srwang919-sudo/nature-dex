.shutter-card{padding:48rpx 25rpx 36rpx;border-radius:var(--radius-card);background:#fff;box-shadow:0 8px 22px #18222a12;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16rpx;position:relative}.leaf-mark{position:absolute;left:62rpx;top:39rpx;color:#b7dfd1;font-size:45rpx;transform:rotate(-28deg)}.camera-symbol{height:150rpx;width:150rpx;border-radius:50%;background:#0e8a72;box-shadow:0 12px 30px #0e8a7240;display:flex;align-items:center;justify-content:center;color:#fff;font-size:61rpx;margin:0}.entry-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.entry-card{min-height:160rpx;box-sizing:border-box;padding:24rpx;border-radius:var(--radius-card);background:#fff;border:1rpx solid #dedbd0;box-shadow:0 6rpx 16rpx #18222a0a;display:flex;flex-direction:column;gap:9rpx}.entry-icon{font-size:42rpx;color:#0e806c}.entry-title{font-size:28rpx;color:#0e806c;font-weight:600}.preview{width:100%;height:630rpx;border-radius:var(--radius-card)}.candidates{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:24rpx 0}.candidate{border-radius:18rpx;background:#f2f0ea;padding:8rpx;text-align:center;font-size:20rpx}.candidate image{width:100%;height:125rpx;border-radius:12rpx;display:block;margin-bottom:10rpx}.selected{background:#6fe0c0;box-shadow:0 0 0 2px #0e8a72}.odds-row{padding:12rpx 0}.recent{display:flex;gap:23rpx;margin-top:24rpx}.recent-card{width:calc((100vw - 122rpx)/3);height:calc((100vw - 122rpx)/3*1.4)}.camera-screen{position:fixed;top:0;bottom:0;left:0;right:0;background:#12221e;z-index:100}.camera-live{width:100%;height:100%}.camera-top{position:absolute;top:30rpx;left:30rpx;right:30rpx;display:flex;justify-content:space-between;color:#fff;font-size:28rpx}.camera-top>cover-view{padding:20rpx;background:#1b2a3380;border-radius:var(--radius-card)}.camera-bottom{position:absolute;bottom:50rpx;left:30rpx;right:30rpx;display:flex;justify-content:space-around;align-items:center;color:#fff;font-size:27rpx}.capture{width:140rpx;height:140rpx;line-height:140rpx;text-align:center;border:8rpx solid #fff;border-radius:100%;background:#0e8a72}.disabled{opacity:.45}.camera-error{position:absolute;top:40%;left:40rpx;right:40rpx;white-space:normal;color:#fff;line-height:1.7;text-align:center}.draft-row{display:flex;align-items:center;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid #d9d7c9;font-size:23rpx}.draft-row image{height:85rpx;width:85rpx;border-radius:12rpx}.draft-row text:last-child{margin-left:auto}
/* C theme alignment, preserving card and capture mechanics. */
.capture-actions{flex-wrap:wrap;gap:12rpx;min-width:0}.capture-actions>.sub{flex-basis:100%;overflow-wrap:anywhere}.capture-actions>button{flex:1;min-width:0;white-space:normal}.candidates{grid-template-columns:repeat(3,minmax(0,1fr))}.candidate{min-width:0;overflow-wrap:anywhere}
.shutter-card,.entry-card{background:var(--surface);box-shadow:none;border:1rpx solid var(--line);border-radius:var(--radius-card)}.camera-symbol{position:relative;background:var(--color-primary);color:var(--paper);box-shadow:none}.camera-drawing::before{content:"";position:absolute;left:40rpx;top:50rpx;width:70rpx;height:50rpx;border:4rpx solid currentColor;border-radius:10rpx;box-sizing:border-box}.camera-drawing::after{content:"";position:absolute;left:61rpx;top:62rpx;width:28rpx;height:28rpx;border:4rpx solid currentColor;border-radius:50%;box-sizing:border-box}.entry-icon{position:relative;width:44rpx;height:44rpx;color:var(--lake)}.album-drawing{border:3rpx solid currentColor;border-radius:6rpx}.album-drawing::after{content:"";position:absolute;left:10rpx;bottom:7rpx;width:20rpx;height:17rpx;border-left:3rpx solid currentColor;border-top:3rpx solid currentColor;transform:rotate(45deg)}.entry-title{color:var(--ink)}.candidate{font-size:24rpx;background:var(--surface);border:1rpx solid var(--line);word-break:break-all}.candidate.selected{background:var(--color-primary-light);box-shadow:none;border:3rpx solid var(--moss)}/* 「探索生境」入口已随 nearby 页面一并下线，入口网格只剩相册导入 → 改单列全宽 */
.entry-grid{grid-template-columns:1fr}
/* hero reused as .observe-hero */
.capture{background:var(--color-primary);border-color:var(--color-surface-2)}.camera-bottom{bottom:calc(32rpx + env(safe-area-inset-bottom))}.draft-row image{flex:none}.draft-row text{min-width:0;word-break:break-all}.draft-row text:last-child{font-size:24rpx;max-width:40%}
.observation-page{background:#192B24;--color-text:#F6F0E5;--ink:#F6F0E5;--color-text-secondary:#C8CFC7;--muted:#C8CFC7;--color-surface-1:#263A30;--surface:#263A30;--color-surface-2:#30483B;--color-border:#4B6052;--line:#4B6052;--color-primary-light:#375541;--moss:#B4C7AA;min-height:100vh;padding-bottom:calc(56rpx + env(safe-area-inset-bottom))}.observation-page .primary{background:#E3EBDD;color:#183F34}.observation-page .link{color:#D2DFC8}.observation-page .notice{color:#4B452F}.observation-page .notice .secondary{color:#F6F0E5}.observation-page .pill{background:transparent;color:#C8CFC7}.observation-page .title{font-size:44rpx}.preview{display:block;max-height:56vh}.process-details{min-height:88rpx;border-top:1rpx solid var(--line);padding-top:20rpx}.camera-top>cover-view{min-height:88rpx;border-radius:16rpx}.capture{background:#F6F0E5;color:#183F34}.camera-screen{background:#192B24}
.capture-hints{display:flex;gap:6rpx;margin-top:24rpx}.capture-hint{flex:1;min-width:0;min-height:88rpx;padding:20rpx 4rpx;font-size:24rpx;border-bottom:2rpx solid transparent}.capture-hint.chosen{color:#E3EBDD;border-color:#E3EBDD;font-weight:600}.capture-hint[disabled]{background:transparent;color:#C8CFC7}.capture-guidance{display:block;margin-top:8rpx}.camera-categories{position:absolute;left:24rpx;right:24rpx;bottom:calc(210rpx + env(safe-area-inset-bottom));display:flex;justify-content:space-around;background:#192B24CC;border-radius:16rpx;color:#F6F0E5}.camera-category{padding:24rpx 12rpx;font-size:26rpx;line-height:40rpx}.camera-category.chosen{background:#E3EBDD;color:#183F34;border-radius:16rpx}
/* 沉浸式观察页 hero：克制、安静，不抢相机主体 */
.observe-hero{margin-bottom:24rpx}
.observe-hero .eyebrow{display:block;color:var(--moss);font-size:22rpx;letter-spacing:.08em;margin-bottom:10rpx}
.observe-hero .title{color:var(--ink);font-size:44rpx}
.observe-hero .sub{display:block;margin-top:14rpx;color:var(--muted);line-height:1.65}
.observe-hero .pill{flex:none}
/* 拍摄主按钮更收一点，避免游戏化大圆 */
.capture-hint{min-height:84rpx;border-radius:0}
.shutter-card{transition:transform .24s cubic-bezier(.22,1,.36,1)}
.shutter-card:active{transform:scale(.985)}
