.notes-page{padding-top:30rpx}.notes-header{margin-bottom:36rpx}.notes-header .title{font-size:44rpx;line-height:1.2}.notes-header .sub{display:block;margin-top:10rpx}.notes-list{display:flex;flex-direction:column;gap:22rpx}.note-card{display:flex;align-items:center;gap:20rpx;padding:24rpx;border-radius:28rpx;background:#fffdf6;border:1rpx solid #ded6c7;box-shadow:0 5rpx 14rpx #18222a0a;transition:transform .14s}.note-card:active{transform:scale(.985)}.note-thumb{width:120rpx;height:120rpx;border-radius:20rpx;flex:none;object-fit:cover;background:#e6e7dc}.note-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx}.note-title-row{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}.note-title-row .section{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.note-title-row .sub{flex:none;font-size:20rpx}.latin{font-style:italic;margin-bottom:2rpx}.note-text{font-size:24rpx;color:#1b2a33;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.chevron{font-size:32rpx;color:#0b6e5c;flex:none;margin-left:6rpx}.empty-state{text-align:center;padding:90rpx 40rpx}.empty-icon{font-size:72rpx;color:#0b6e5c;margin-bottom:18rpx}.empty-title{display:block;font-size:34rpx;font-weight:600;color:#17352d;margin-bottom:12rpx}.empty-state .sub{display:block;margin-bottom:36rpx}.empty-state .primary{width:260rpx;margin:0 auto}
/* C theme alignment, preserving card and capture mechanics. */
.note-card{background:var(--surface);border-color:var(--line);box-shadow:none;transition:none}.note-card:active{transform:none}.note-title-row{flex-wrap:wrap}.note-title-row .section{white-space:normal;overflow:visible;font-size:30rpx}.note-title-row .sub{font-size:24rpx}.note-text{color:var(--ink);font-size:26rpx}.note-pencil{width:18rpx;height:60rpx;background:var(--moss);border:3rpx solid var(--ink);transform:rotate(35deg);margin:0 auto 28rpx;border-radius:6rpx}.empty-state{padding:56rpx 16rpx}.empty-state .primary{width:100%;min-height:88rpx}
