<view class="page library-page {{reduceMotion?'reduce-motion':''}}">
  <view class="library-hero">
    <text class="eyebrow">PRIVATE COLLECTION</text>
    <view class="title">我的馆藏</view>
    <text class="sub">收集自然，也收藏与它相遇的时刻。</text>
  </view>

  <view wx:if="{{ownedCount}}" class="library-search">
    <input class="search-input" value="{{query}}" bindinput="searchInput" placeholder="搜物种名、学名或地点" aria-label="搜索我的收藏" confirm-type="search"/>
    <button wx:if="{{query}}" class="search-clear" bindtap="clearSearch" aria-label="清除搜索">清除</button>
  </view>

  <scroll-view wx:if="{{ownedCount}}" class="category-scroll" scroll-x="{{true}}" enable-flex="{{true}}">
    <view class="category-row">
      <button wx:for="{{categories}}" wx:key="key" class="category-button {{category===item.key?'selected':''}}" data-category="{{item.key}}" bindtap="selectCategory" aria-label="{{item.label+(category===item.key?'，已选':'')}}">{{item.label}}</button>
    </view>
  </scroll-view>

  <view class="layout-switch" aria-label="收藏布局">
    <button class="layout-button {{layout==='neat'?'selected':''}}" data-layout="neat" bindtap="setCollectionLayout" aria-label="{{layout==='neat'?'整齐，已选':'整齐'}}">整齐</button>
    <button class="layout-button {{layout==='shelf'?'selected':''}}" data-layout="shelf" bindtap="setCollectionLayout" aria-label="{{layout==='shelf'?'卡架，已选':'卡架'}}">卡架</button>
  </view>

  <block wx:if="{{cards.length}}">
    <view wx:if="{{layout==='neat'}}" class="card-grid">
      <view wx:for="{{cards}}" wx:key="id" class="collection-item" data-id="{{item.id}}" bindtap="open" aria-role="button" aria-label="{{'查看'+item.zh+'的收藏卡'}}">
        <view class="collection-card"><collectible card="{{item}}"/></view>
      </view>
    </view>
    <view wx:else class="card-shelf">
      <swiper class="shelf-swiper" current="{{shelfIndex}}" autoplay="{{false}}" circular="{{false}}" duration="{{reduceMotion?0:260}}" previous-margin="28rpx" next-margin="28rpx" bindchange="shelfChange">
        <swiper-item wx:for="{{cards}}" wx:key="id">
          <view class="shelf-item" data-id="{{item.id}}" bindtap="open" aria-role="button" aria-label="{{'查看'+item.zh+'的收藏卡'}}">
            <view class="shelf-card"><collectible card="{{item}}" large="{{true}}" motion="{{false}}"/></view>
          </view>
        </swiper-item>
      </swiper>
      <view class="shelf-counter">{{shelfIndex+1}} / {{cards.length}} · 左右滑动，轻点查看</view>
    </view>
  </block>

  <view wx:elif="{{query || category!=='all'}}" class="library-empty">
    <view class="section">没有匹配的收藏</view>
    <text class="sub">换个名字试试，或清除筛选看全部 {{ownedCount}} 张卡。</text>
    <button class="secondary" bindtap="clearSearch">查看全部收藏</button>
  </view>

  <view wx:else class="library-empty">
    <view class="section">拍下下一次遇见</view>
    <text class="sub">你的第一张收藏卡，会从一次真实观察开始。</text>
    <button class="primary" bindtap="explore">去拍一张</button>
  </view>

  <view wx:if="{{syncing}}" class="sub sync-status" role="status">正在恢复我的云端卡片…</view>
  <view wx:if="{{syncError}}" class="notice spaced">{{syncError}}<button bindtap="sync">重试同步</button></view>
</view>
<navigation active="collection"/>
<privacy-consent id="nature-privacy"/>
