/* 底部主导航 · 贴底栏
   与 .page 的 184rpx 底部留白配套。参考图要求：细线图标、深绿选中、暖白背景、轻微顶部分割线。 */
.dock{position:fixed;bottom:0;left:0;right:0;z-index:20;padding:10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom));background:var(--color-bg);border-top:1rpx solid var(--color-border);pointer-events:none}
.tabs{height:108rpx;display:flex;pointer-events:auto}
.tab{position:relative;flex:1;min-width:0;min-height:88rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;font-family:'PingFang SC',sans-serif;font-size:22rpx;color:var(--color-text-secondary);transition:color .24s ease}
/* 选中态：墨绿文字 + 图标下方短下划线，不用背景块 */
.tab.on{color:var(--color-primary);font-weight:600}
.tab.on::after{content:'';position:absolute;bottom:10rpx;width:24rpx;height:3rpx;border-radius:3rpx;background:var(--color-primary)}
.icon-wrap{width:64rpx;height:44rpx;display:flex;align-items:center;justify-content:center}
.tab-label{line-height:1.2}
.reduce-motion .tab{transition:none}

/* ---- 图标：极细 CSS 线框，与参考图的安静气质一致 ---- */
.icon{position:relative;width:28rpx;height:26rpx;color:inherit;box-sizing:border-box}
/* 探索 · 一片叶子 */
.leaf{border:2rpx solid currentColor;border-radius:100% 0 100% 0;transform:rotate(-38deg);width:24rpx;height:26rpx}.leaf::after{content:'';position:absolute;left:10rpx;top:4rpx;height:20rpx;border-left:1.5rpx solid currentColor;transform:rotate(38deg)}
/* 馆藏 · 打开的书 */
.book{border:2rpx solid currentColor;border-radius:3rpx 5rpx 5rpx 3rpx}.book::after{content:'';position:absolute;left:13rpx;top:2rpx;bottom:2rpx;border-left:1.5rpx solid currentColor}
.book::before{content:'';position:absolute;left:4rpx;top:50%;right:4rpx;height:1rpx;background:currentColor}
/* 旅程 · 蜿蜒小径 */
.trail{position:absolute;left:0;top:12rpx;width:28rpx;height:12rpx;border-top:2rpx solid currentColor;border-radius:0 50% 50% 0;transform:rotate(-6deg)}.trail::after{content:'';position:absolute;right:0;top:-5rpx;width:6rpx;height:6rpx;border:2rpx solid currentColor;border-radius:50%;background:transparent}
/* 好友 · 两个并肩小人（抽象：前后两颗圆点头像） */
.friends{transform:scale(.92)}.friends::before{content:'';position:absolute;left:1rpx;top:3rpx;width:10rpx;height:10rpx;border:2rpx solid currentColor;border-radius:50%;box-sizing:border-box}.friends::after{content:'';position:absolute;right:0;bottom:2rpx;width:9rpx;height:9rpx;border:2rpx solid currentColor;border-radius:50%;box-sizing:border-box;background:var(--color-bg)}
/* 我的 · 单人轮廓 */
.person::before{content:'';position:absolute;left:9rpx;top:0;width:10rpx;height:10rpx;border:2rpx solid currentColor;border-radius:50%}.person::after{content:'';position:absolute;left:3rpx;bottom:0;width:22rpx;height:9rpx;border:2rpx solid currentColor;border-radius:11rpx 11rpx 3rpx 3rpx}
