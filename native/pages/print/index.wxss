.print-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #ddd9cf}.print-row>view{min-width:0;flex:1}.print-row text{display:block;overflow-wrap:anywhere}.print-row button{flex-shrink:0}.print-item{padding:24rpx 0;border-bottom:1rpx solid #ddd9cf}.print-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:14rpx}.print-actions button{width:100%;min-width:0}.print-canvas{position:fixed;left:-2000px;top:0;width:815px;height:1110px}.print-page{padding-bottom:80rpx}
