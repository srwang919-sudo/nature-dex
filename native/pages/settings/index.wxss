.mine-page{padding-top:42rpx}.profile{display:flex;align-items:center;gap:22rpx}.profile-mark{width:88rpx;height:88rpx;border-radius:50%;background:#6edcc0;color:#183b34;text-align:center;padding-top:18rpx;box-sizing:border-box;font-size:24rpx;line-height:1.1}.stats-panel{padding:28rpx;border:1rpx solid #dedbd0;border-radius:30rpx;background:#fff;box-shadow:0 7rpx 20rpx #18222a0b}.stats{display:flex;justify-content:space-around;text-align:center}.stats>view{min-width:0;display:flex;flex-direction:column;gap:10rpx;font-size:20rpx;color:#5c6b76}.number{font-size:48rpx;color:#0b6e5c}.progress-rule{height:1rpx;background:#e0ded6;margin:24rpx 0}.track{height:13rpx;border-radius:10rpx;background:#ebe9df;margin:16rpx 0;overflow:hidden}.fill{height:100%;border-radius:inherit;background:#6bd8bc}.empty-note{padding:22rpx;border-radius:22rpx;background:#f5f3ec;color:#5c6b76;font-size:22rpx;line-height:1.6}.note-card{padding:24rpx;margin-top:16rpx;border-radius:24rpx;background:#fff;border:1rpx solid #dfddd3;box-shadow:0 5rpx 14rpx #18222a09}.note-card .sub{margin-top:10rpx;line-height:1.6}.record{display:flex;align-items:center;gap:22rpx;padding:19rpx 0;border-bottom:1rpx solid #d9d7c9;font-size:25rpx}.record image{width:95rpx;height:110rpx;border-radius:14rpx;flex-shrink:0}.record .grow{min-width:0;word-break:break-all}.setting-card{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:25rpx;margin-top:16rpx;border-radius:26rpx;background:#fff;border:1rpx solid #dfddd3;box-shadow:0 5rpx 14rpx #18222a09}.setting-card .sub{line-height:1.55;margin-top:8rpx}.danger{color:#b03a26}
/* C theme alignment, preserving card and capture mechanics. */
.profile-mark{background:#E7EBD9;color:var(--ink);display:flex;align-items:center;justify-content:center;padding:0}.stats-panel,.note-card,.setting-card{background:var(--surface);border-color:var(--line);box-shadow:none}.number{color:var(--ink);font-size:40rpx}.stats>view{font-size:24rpx;color:var(--muted)}.empty-note{background:var(--surface);color:var(--muted);font-size:26rpx}.setting-card>view{flex:1;min-width:0}.setting-card switch{flex:none}.record>view{min-width:0;word-break:break-all}.note-card .sub{word-break:break-all}
