.nearby-page{padding-top:42rpx}
.privacy-card,.season-card,.etiquette-card{padding:28rpx;border-radius:30rpx;border:1rpx solid var(--color-border)}
.privacy-card{background:var(--color-primary-light)}
.season-card{background:var(--color-surface-1)}
.etiquette-card{background:var(--color-surface-2)}
.sort-pill,.season-pill{padding:11rpx 18rpx;border:1rpx solid var(--color-border);border-radius:40rpx;background:var(--color-bg);color:var(--color-text);font-size:24rpx}
.season-pill{flex:none;text-align:center;max-width:100%;line-height:1.3;margin-left:auto}
.habitat{display:flex;align-items:center;gap:20rpx;padding:22rpx;border-radius:28rpx;background:var(--color-surface-1);border:1rpx solid var(--color-border);margin-bottom:18rpx;min-height:132rpx;flex-wrap:wrap}
.habitat image{width:112rpx;height:132rpx;border-radius:20rpx;flex:none}
.habitat .section{font-size:30rpx}
.habitat .grow{flex-basis:250rpx}
.latin-row{font-style:italic;margin-bottom:4rpx}
/* ===== 地区图鉴（§11）：本季清单进度，只用本机数据 ===== */
.atlas-card{padding:28rpx var(--space-md);background:var(--color-surface-1);border:1rpx solid var(--color-border);border-radius:var(--radius-lg)}
.atlas-progress{flex:none;font-size:30rpx;color:var(--color-primary)}
.atlas-bar{height:12rpx;margin-top:20rpx;background:var(--color-surface-3);border:1rpx solid var(--color-border);border-radius:999rpx;overflow:hidden}
.atlas-bar-fill{height:100%;background:var(--color-primary);border-radius:999rpx;transition:width .4s ease}
.atlas-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-sm);margin-top:var(--space-md)}
.atlas-item{display:flex;flex-direction:column;gap:8rpx;min-width:0;padding:18rpx var(--space-sm);border:1rpx solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface-2)}
.atlas-item.found{border-color:var(--color-primary);background:var(--color-primary-light)}
.atlas-item.missing{border-style:dashed;background:transparent;opacity:.85}
.atlas-item.missing .atlas-name{color:var(--color-text-secondary)}
.atlas-name{font-size:28rpx;color:var(--color-text);overflow-wrap:anywhere}
.atlas-habitat{font-size:22rpx;line-height:1.4;overflow-wrap:anywhere}
.atlas-places{display:flex;flex-direction:column;gap:14rpx;margin-top:var(--space-md);padding-top:20rpx;border-top:1rpx solid var(--color-border)}
.atlas-place{display:flex;flex-direction:column;gap:6rpx;font-size:28rpx;color:var(--color-text);overflow-wrap:anywhere}
