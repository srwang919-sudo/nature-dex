.dock{position:fixed;bottom:0;left:0;right:0;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));z-index:20;pointer-events:none}
.tabs{height:112rpx;border-radius:32rpx;padding:0 8rpx;background:#FFFCF4;display:flex;box-shadow:0 6rpx 24rpx #183f3614;pointer-events:auto;border:1rpx solid #DED8C6}
.tab{position:relative;flex:1;min-width:0;min-height:88rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;font-family:'PingFang SC',sans-serif;font-size:24rpx;color:#52635A}
.tab.on{color:#183F36;font-weight:600}.tab.on .icon-wrap{background:#E7EBD9}
.icon-wrap{width:68rpx;height:44rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center}
.tab-label{line-height:1.3}.capture-action{justify-content:flex-end;padding-bottom:8rpx}
.capture-disc{position:absolute;top:0;width:112rpx;height:112rpx;transform:translateY(-16rpx);border:8rpx solid #FFF8E8;border-radius:50%;background:#B8492A;color:#FFF8E8;display:flex;align-items:center;justify-content:center}
.capture-action .tab-label{position:relative;z-index:1;color:#183F36;font-weight:600;transform:translateY(8rpx);background:#FFFCF4;border-radius:12rpx;padding:0 8rpx}
.icon{position:relative;width:32rpx;height:30rpx;color:inherit;box-sizing:border-box}
.book{border:3rpx solid currentColor;border-radius:4rpx}.book::after{content:'';position:absolute;left:12rpx;top:0;bottom:0;border-left:2rpx solid currentColor}
.leaf{border:3rpx solid currentColor;border-radius:100% 0 100% 0;transform:rotate(-38deg);width:26rpx;height:30rpx}.leaf::after{content:'';position:absolute;left:10rpx;top:5rpx;height:24rpx;border-left:2rpx solid currentColor;transform:rotate(38deg)}
.person::before{content:'';position:absolute;left:10rpx;top:0;width:12rpx;height:12rpx;border:3rpx solid currentColor;border-radius:50%}.person::after{content:'';position:absolute;left:3rpx;bottom:0;width:26rpx;height:11rpx;border:3rpx solid currentColor;border-radius:14rpx 14rpx 4rpx 4rpx}
.camera{width:42rpx;height:32rpx;border:3rpx solid currentColor;border-radius:7rpx}.camera::before{content:'';position:absolute;width:16rpx;height:16rpx;left:10rpx;top:5rpx;border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box}.camera::after{content:'';position:absolute;width:16rpx;height:6rpx;left:10rpx;top:-8rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:4rpx 4rpx 0 0}
