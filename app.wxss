page{background:#f8f4e9;color:#17352d;font-family:'PingFang SC',-apple-system,BlinkMacSystemFont,'Microsoft YaHei',sans-serif;font-size:26rpx;-webkit-font-smoothing:antialiased}view,text,button{box-sizing:border-box}button{font:inherit;margin:0;line-height:1.45}button::after{border:none}.page{padding:30rpx 38rpx calc(190rpx + env(safe-area-inset-bottom))}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.title{font-size:44rpx;font-weight:600;letter-spacing:1rpx}.sub{font-size:27rpx;color:#5C6B76;line-height:1.7}.green{color:#0B6E5C}.section{font-size:31rpx;font-weight:500}.panel{background:#fffdf6;border-radius:28rpx;padding:26rpx;box-shadow:0 0 0 1px #cfc9ba,0 6px 16px #18222a0d}.spaced{margin-top:30rpx}.pill{padding:10rpx 19rpx;border-radius:50rpx;background:#fffdf6;font-size:22rpx;box-shadow:0 0 0 1px #cfc9ba,0 2px 5px #18222a08;white-space:nowrap}.pill.on{background:#e3eee5;color:#174f42}.primary,.secondary{display:flex;align-items:center;justify-content:center;min-height:90rpx;padding:20rpx;border-radius:30rpx;text-align:center;transition:transform .16s}.primary{background:#174f42;color:#fffdf6;font-weight:600;box-shadow:0 8px 20px #174f4242}.secondary{background:#fffdf6;color:#41505B;box-shadow:0 0 0 1px #cfc9ba,0 2px 5px #18222a08}.primary[disabled],.secondary[disabled]{opacity:.45}.primary:active,.secondary:active{transform:scale(.976)}.track{height:24rpx;background:#F2F0EA;border-radius:20rpx;overflow:hidden;margin:20rpx 0 12rpx}.fill{height:100%;background:#78aa8f;border-radius:20rpx}.hint{text-align:center;font-size:25rpx;color:#5C6B76;line-height:1.7}.notice{padding:20rpx 24rpx;border-radius:24rpx;background:#FFF3D6;font-size:26rpx;line-height:1.65;color:#735631}.link{color:#0B6E5C;font-size:25rpx;background:none;padding:12rpx}.empty{text-align:center;padding:55rpx 24rpx;color:#5C6B76;background:#F2F0EA}.muted{color:#5C6B76}.small{font-size:24rpx}.grow{flex:1}.title,.brand{font-family:'Kaiti SC','STKaiti','PingFang SC',serif}.font-number,.number,.stats{font-family:'DIN Alternate','PingFang SC',-apple-system,sans-serif}
.secondary.danger{color:#A83B30}
/* C: bright natural-exploration foundation; collectible front stays isolated. */
page{--paper:#FFF8E8;--surface:#FFFCF4;--ink:#183F36;--muted:#52635A;--moss:#647B42;--lake:#3C7F92;--orange:#B8492A;--sun:#F2CF70;--line:#DED8C6;background:var(--paper);color:var(--ink);font-size:28rpx;line-height:1.55}
.page{padding:32rpx 32rpx calc(184rpx + env(safe-area-inset-bottom))}
.title,.brand{font-family:'PingFang SC',-apple-system,BlinkMacSystemFont,'Microsoft YaHei',sans-serif}
.title{font-size:44rpx;line-height:1.3}.section{font-size:34rpx;font-weight:600;line-height:1.4}
.sub,.hint{font-size:24rpx;color:var(--muted);line-height:1.55}.muted{color:var(--muted)}.green{color:var(--ink)}
.panel{background:var(--surface);border:1rpx solid var(--line);border-radius:28rpx;padding:24rpx;box-shadow:none}
.spaced{margin-top:32rpx}.pill{background:var(--surface);font-size:24rpx;border:1rpx solid var(--line);box-shadow:none}.pill.on{background:#E7EBD9;color:var(--ink)}
.primary,.secondary{min-height:88rpx;padding:20rpx 24rpx;border-radius:24rpx;box-shadow:none;transition:transform .2s cubic-bezier(.22,1,.36,1)}
.primary{background:var(--orange);color:var(--paper)}.secondary{background:var(--surface);color:var(--ink);border:1rpx solid var(--line)}
.primary[disabled],.secondary[disabled]{opacity:1;background:#ECE7DB;color:#687269;border-color:var(--line)}
.primary:active,.secondary:active{transform:scale(.98)}
.track{height:20rpx;background:#E8E7D9}.fill{background:var(--moss)}
.notice{background:#F7EBCB;color:var(--ink);line-height:1.55}
.link{color:var(--ink);font-size:26rpx;padding:16rpx;min-height:88rpx}
.empty{color:var(--muted);background:var(--surface)}.grow{min-width:0}
.reduce-motion .primary,.reduce-motion .secondary{transition:none;transform:none}
@media(prefers-reduced-motion:reduce){.primary,.secondary{transition:none}.primary:active,.secondary:active{transform:none}}
