.journey-page>.title{margin-top:8rpx}.journey-empty{padding:72rpx 0;max-width:620rpx}.journey-empty>.sub{display:block;margin-top:24rpx}.month-section{margin-top:48rpx}.journey-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx;margin-top:24rpx}.journey-card{aspect-ratio:5/7;min-width:0}.place-row{display:flex;justify-content:space-between;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}
